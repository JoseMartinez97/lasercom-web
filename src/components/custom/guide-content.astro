---
import { getEntry, render } from "astro:content"
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import CloseSection from "@/components/custom/close-section.astro"
import GuideCards from "@/components/custom/guide-cards.astro"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { guideIds, guides, guidesUpdated, type GuideId } from "@/lib/guides"
import { services } from "@/lib/services"
import { ArrowRight } from "lucide-react"

interface Props {
  lang: Lang
  id: GuideId
}
const { lang, id } = Astro.props
const t = useTranslations(lang)
const guide = guides[id]
const entry = await getEntry("guides", `${lang}/${id}`)
if (!entry) throw new Error(`No guide ${lang}/${id}`)
const { Content } = await render(entry)
const updated = new Intl.DateTimeFormat(lang, { dateStyle: "long" }).format(
  new Date(guidesUpdated)
)
---

<article>
  <header class="grid gap-10 px-5 pt-8 pb-16 md:px-8 lg:grid-cols-12 lg:pt-12 lg:pb-20">
    <div class="flex flex-col gap-8 lg:col-span-7">
      <nav
        aria-label={t("a11y.breadcrumb")}
        class="hero-in text-sm text-muted-foreground"
        style="--i: 0"
      >
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              href={localizePath(lang, "/")}
              class="-my-3 inline-block py-3 hover:text-foreground"
            >
              {t("crumb.home")}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              href={localizePath(lang, "/guias/")}
              class="hover:text-foreground"
            >
              {t("nav.guides")}
            </a>
          </li>
        </ol>
      </nav>
      <p
        class="readout hero-in flex flex-wrap items-center gap-3 text-muted-foreground"
        style="--i: 1"
      >
        <span class="beam-dot inline-block size-2 rounded-full bg-laser"></span>
        {`${t("guides.label")} · ${t(`guide.${id}.minutes`)} ${t("guides.minutes")} · ${t("guides.updated")}`}
        <time datetime={guidesUpdated}>{updated}</time>
      </p>
      <h1 class="display text-[clamp(2.4rem,5.4vw,5.5rem)] [font-stretch:110%] sm:[font-stretch:125%]">
        <span class="engrave" style="--i: 0">
          <span class="engrave-text">{t(`guide.${id}.h1`)}</span>
        </span>
      </h1>
      <p
        class="hero-lead max-w-2xl text-lg text-muted-foreground md:text-xl"
        style="--i: 3"
      >
        {t(`guide.${id}.lead`)}
      </p>
    </div>
    <div
      class="hero-in relative aspect-[4/3] overflow-hidden rounded-[1.75rem] border border-border/75 bg-paper lg:col-span-5 lg:aspect-auto"
      style="--i: 2"
    >
      <WorkPhoto
        lang={lang}
        name={guide.photo}
        loading="eager"
        sizes="(min-width: 1024px) 40vw, 100vw"
        data-parallax=""
        class="absolute inset-0 size-full"
      />
    </div>
  </header>

  <div class="grid gap-14 border-t border-border px-5 py-16 md:px-8 lg:grid-cols-12 lg:py-24">
    <div class="prose-guide lg:col-span-7 lg:col-start-2">
      <Content />
    </div>
    <aside class="lg:col-span-3 lg:col-start-10">
      <div class="flex flex-col gap-5 lg:sticky lg:top-28">
        <h2 class="readout text-muted-foreground">{t("guides.services")}</h2>
        <ul class="flex flex-col">
          {guide.services.map((s) => (
            <li class="border-t border-border">
              <a
                href={lang === "en" ? services[s].en : services[s].es}
                class="group flex items-center justify-between gap-4 py-4 font-semibold hover:text-laser-ink"
              >
                {t(`svc.${s}.name`)}
                <ArrowRight className="size-4 shrink-0 text-laser-ink transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
        <a
          href={`${localizePath(lang, "/contacto/")}#presupuesto`}
          class={buttonVariants({
            size: "cta",
          })}
        >
          {t("cta.quote")}
          <ArrowRight className="size-5" />
        </a>
      </div>
    </aside>
  </div>
</article>

<section class="border-t border-border px-5 py-24 md:px-8 lg:py-32">
  <h2 class="readout mb-6 text-muted-foreground">{t("guides.more")}</h2>
  <GuideCards lang={lang} ids={guideIds.filter((g) => g !== id).slice(0, 3)} />
</section>

<CloseSection lang={lang} />
