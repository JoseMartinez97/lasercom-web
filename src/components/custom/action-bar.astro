---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { telHref, whatsappHref } from "@/lib/business"
import { ArrowUpRight, MessageCircle, Phone } from "lucide-react"

interface Props {
  lang: Lang
  whatsappText?: string
}
const { lang, whatsappText } = Astro.props
const t = useTranslations(lang)
const message = whatsappText ?? t("wa.default")
---

<nav
  data-action-bar
  aria-label={t("bar.label")}
  transition:persist={`action-bar-${lang}`}
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-background/95 px-3 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] backdrop-blur-md sm:px-4 md:hidden"
>
  <div class="mx-auto flex max-w-md items-center gap-2">
    <a
      data-action-call
      href={telHref}
      aria-label={t("bar.call")}
      class="inline-flex h-11 shrink-0 items-center justify-center gap-1.5 rounded-full border border-border bg-card px-3 text-xs font-medium whitespace-nowrap text-foreground transition-colors active:scale-95 sm:px-4"
    >
      <Phone className="size-4 shrink-0 text-muted-foreground" aria-hidden />
      <span>{t("bar.call")}</span>
    </a>
    <a
      data-action-wa
      href={whatsappHref(message)}
      target="_blank"
      rel="noopener"
      class="inline-flex h-11 shrink-0 items-center justify-center gap-1.5 rounded-full border border-border bg-card px-3 text-xs font-medium whitespace-nowrap text-foreground transition-colors active:scale-95 sm:px-4"
    >
      <MessageCircle
        className="size-4 shrink-0 text-(--whatsapp)"
        aria-hidden
      />
      <span>{t("cta.whatsapp.short")}</span>
    </a>
    <a
      data-action-quote
      href={`${localizePath(lang, "/contacto/")}#presupuesto`}
      class="inline-flex h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-primary px-3 text-xs font-semibold whitespace-nowrap text-primary-foreground transition-transform active:scale-95 sm:px-4"
    >
      <span>{t("bar.quote")}</span>
      <ArrowUpRight className="size-3.5 shrink-0" aria-hidden />
    </a>
  </div>
</nav>
