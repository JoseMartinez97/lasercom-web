---
import { cn } from "@/lib/utils"

interface Props {
  src: string
  loop?: boolean
  speed?: number
  label?: string
  class?: string
}

const { src, loop = true, speed = 1, label, class: className } = Astro.props
---

<div
  data-lottie-src={src}
  data-lottie-loop={String(loop)}
  data-lottie-speed={String(speed)}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  class={cn("relative flex items-center justify-center", className)}
></div>

<script>
  import type { AnimationItem } from "lottie-web"
  import { afterLoad } from "@/lib/after-load"

  const cleanups: (() => void)[] = []

  const teardownAll = () => {
    while (cleanups.length > 0) {
      cleanups.pop()?.()
    }
  }

  const bootLottiePlayers = () => {
    teardownAll()

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches
    const containers =
      document.querySelectorAll<HTMLElement>("[data-lottie-src]")

    containers.forEach((container) => {
      const path = container.dataset.lottieSrc
      if (!path) return

      const loop = container.dataset.lottieLoop !== "false"
      const parsedSpeed = Number(container.dataset.lottieSpeed)
      const speed = Number.isFinite(parsedSpeed) ? parsedSpeed : 1

      let cancelled = false
      let loaded = false
      let anim: AnimationItem | null = null

      const load = async () => {
        if (cancelled || loaded) return
        loaded = true

        try {
          const { default: lottie } = await import("lottie-web")
          if (cancelled) return

          anim = lottie.loadAnimation({
            container,
            renderer: "svg",
            loop: reducedMotion ? false : loop,
            autoplay: !reducedMotion,
            path,
            rendererSettings: {
              preserveAspectRatio: "xMidYMid meet",
              progressiveLoad: true,
            },
          })

          anim.setSpeed(speed)
          if (reducedMotion) {
            anim.addEventListener("DOMLoaded", () => {
              anim?.goToAndStop(0, true)
            })
          }
        } catch {
          // Non-critical decorative motion; fail silently if offline
        }
      }

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((entry) => entry.isIntersecting)
          if (visible) {
            if (!loaded) {
              afterLoad(() => void load())
            } else if (!reducedMotion) {
              anim?.play()
            }
          } else {
            anim?.pause()
          }
        },
        { rootMargin: "160px 0px" }
      )

      observer.observe(container)

      cleanups.push(() => {
        cancelled = true
        observer.disconnect()
        anim?.destroy()
        anim = null
      })
    })
  }

  document.addEventListener("astro:page-load", bootLottiePlayers)
  document.addEventListener("astro:before-swap", teardownAll)
  window.addEventListener("pagehide", teardownAll)
</script>
