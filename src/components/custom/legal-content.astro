---
import { getEntry, render } from "astro:content"

interface Props {
  slug: string
}
const entry = await getEntry("legal", Astro.props.slug)
if (!entry) throw new Error(`No legal page ${Astro.props.slug}`)
const { Content } = await render(entry)
---

<section class="px-5 pt-10 pb-24 md:px-8 lg:pt-16">
  <h1 class="display mb-10 text-[clamp(2.5rem,6vw,5.5rem)]">
    {entry.data.title}
  </h1>
  <div class="prose-legal">
    <Content />
  </div>
</section>
