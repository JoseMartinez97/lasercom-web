---
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import OpenStatus from "@/components/custom/open-status.astro"
import { business, mailHref, telHref, whatsappHref } from "@/lib/business"
import { ArrowUpRight, Mail, MapPin, Phone } from "lucide-react"

interface Props {
  lang: Lang
  title?: string
  message?: string
}
const { lang } = Astro.props
const t = useTranslations(lang)
const title = Astro.props.title ?? t("close.title")
const message = Astro.props.message ?? t("wa.default")
---

<section id="contacto" class="scroll-mt-20 px-5 py-16 md:px-8 md:py-24">
  <div
    data-close
    class="steel-rings relative mx-auto max-w-7xl overflow-hidden rounded-3xl border border-border bg-card px-6 py-12 md:px-12 md:py-16 lg:px-16 lg:py-20"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 1000 120"
      preserveAspectRatio="none"
      class="pointer-events-none absolute inset-x-0 top-0 h-20 w-full text-laser/65"
    >
      <path
        data-cut
        d="M0 24 H340 L372 56 H1000"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
      ></path>
    </svg>
    <div class="flex flex-col gap-8">
      <p class="readout text-muted-foreground">
        {business.locality} · {business.region} · {business.founded}
      </p>
      <h2
        data-title-chars
        class="display max-w-[16ch] text-[clamp(1.95rem,6vw,5.25rem)] text-foreground"
      >
        {title}
      </h2>
      <p
        data-lines
        class="max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg"
      >
        {t("close.text")}
      </p>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
        <a
          href={whatsappHref(message)}
          target="_blank"
          rel="noopener"
          data-magnetic
          class={buttonVariants({
            size: "cta",
            className: "w-full sm:w-auto",
          })}
        >
          {t("cta.whatsapp")}
          <ArrowUpRight className="size-4" aria-hidden />
        </a>
        <a
          href={telHref}
          class={buttonVariants({
            variant: "outline",
            size: "cta",
            className:
              "w-full border-border bg-transparent font-medium hover:bg-secondary sm:w-auto",
          })}
        >
          <Phone className="size-4 text-muted-foreground" aria-hidden />
          {business.phoneDisplay}
        </a>
        <a
          href={mailHref(t("quote.subject"))}
          class={buttonVariants({
            variant: "ghost",
            size: "cta",
            className:
              "w-full font-medium text-muted-foreground hover:text-foreground sm:w-auto",
          })}
        >
          <Mail className="size-4" aria-hidden />
          {business.email}
        </a>
      </div>
    </div>

    <dl class="mt-14 grid gap-8 border-t border-border pt-10 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.workshop")}</dt>
        <dd class="text-sm leading-relaxed text-foreground md:text-base">
          <a
            href={business.mapsUrl}
            target="_blank"
            rel="noopener"
            class="group inline-flex gap-2.5 transition-colors hover:text-laser-ink"
          >
            <MapPin
              className="mt-1 size-4 shrink-0 text-laser-ink"
              aria-hidden
            />
            <span>
              {business.street}
              <br />
              {`${business.postalCode} ${business.locality}`}
              <span class="mt-1 block text-xs text-muted-foreground">
                {t("close.estate")} · {t("cta.directions")} ↗
              </span>
            </span>
          </a>
        </dd>
      </div>
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.hours")}</dt>
        <dd class="text-sm leading-relaxed text-foreground md:text-base">
          {t("close.hours.weekdays")}
          <br />
          {t("close.hours.friday")}
          <OpenStatus lang={lang} class="mt-3 text-muted-foreground" />
        </dd>
      </div>
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.phone")}</dt>
        <dd class="flex flex-col gap-1 text-sm text-foreground md:text-base">
          <a
            href={telHref}
            class="inline-flex min-h-11 w-fit items-center transition-colors hover:text-laser-ink"
          >
            {business.phoneDisplay}
          </a>
          <a
            href={`tel:${business.landline}`}
            class="inline-flex min-h-11 w-fit items-center text-muted-foreground transition-colors hover:text-foreground"
          >
            {business.landlineDisplay}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
