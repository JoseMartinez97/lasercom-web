---
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import { business, mailHref, telHref, whatsappHref } from "@/lib/business"
import { ArrowUpRight, Mail, MapPin, Phone } from "lucide-react"

interface Props {
  lang: Lang
  // Page-specific headline and WhatsApp message; the layout never changes
  title?: string
  message?: string
}
const { lang } = Astro.props
const t = useTranslations(lang)
const title = Astro.props.title ?? t("close.title")
const message = Astro.props.message ?? t("wa.default")
import OpenStatus from "@/components/custom/open-status.astro"
---

<section
  id="contacto"
  class="scroll-mt-16 overflow-hidden px-2 pb-2 md:px-3 md:pb-3"
>
  <div
    data-close
    class="steel relative flex min-h-[calc(100svh-4.75rem)] flex-col justify-between gap-14 overflow-hidden rounded-[1.75rem] px-5 py-14 md:px-10 md:py-20"
  >
    <!-- The beam's cut line, drawn as the panel arrives -->
    <svg
      aria-hidden="true"
      viewBox="0 0 1000 300"
      preserveAspectRatio="none"
      class="pointer-events-none absolute inset-x-0 top-0 h-40 w-full text-laser opacity-70"
    >
      <path
        data-cut
        d="M0 40 H340 L380 90 H1000"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        vector-effect="non-scaling-stroke"
      ></path>
    </svg>

    <div class="flex flex-col gap-8">
      <h2
        class="display max-w-[14ch] text-[clamp(2.75rem,9vw,8.5rem)]"
        data-title-chars
      >
        {title}
      </h2>
      <p class="max-w-2xl text-lg text-muted-foreground md:text-xl">
        {t("close.text")}
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <!-- The pointer pulls this button within its padded area -->
        <span class="flex sm:-m-6 sm:p-6">
          <a
            href={whatsappHref(message)}
            target="_blank"
            rel="noopener"
            data-magnetic
            class={buttonVariants({
              size: "lg",
              className: "h-14 w-full rounded-full px-7 text-base sm:w-auto",
            })}
          >
            {t("cta.whatsapp")}
            <ArrowUpRight className="size-5" />
          </a>
        </span>
        <a
          href={telHref}
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            className:
              "h-14 rounded-full border-foreground/30 bg-transparent px-7 text-base",
          })}
        >
          <Phone className="size-4" />
          {business.phoneDisplay}
        </a>
        <a
          href={mailHref(t("quote.subject"))}
          class={buttonVariants({
            variant: "ghost",
            size: "lg",
            className: "h-14 rounded-full px-7 text-base",
          })}
        >
          <Mail className="size-4" />
          {business.email}
        </a>
      </div>
    </div>

    <dl class="grid gap-8 border-t border-border pt-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.workshop")}</dt>
        <dd class="text-lg">
          <a
            href={business.mapsUrl}
            target="_blank"
            rel="noopener"
            class="group inline-flex gap-2 hover:text-laser-ink"
          >
            <MapPin className="mt-1 size-4 shrink-0 text-laser-ink" />
            <span>
              {business.street}
              <br />
              {`${business.postalCode} ${business.locality}`}
              <span class="mt-1 block text-sm text-muted-foreground">
                {t("close.estate")} · {t("cta.directions")} ↗
              </span>
            </span>
          </a>
        </dd>
      </div>
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.hours")}</dt>
        <dd class="text-lg">
          {t("close.hours.weekdays")}
          <br />
          {t("close.hours.friday")}
          <OpenStatus lang={lang} class="mt-3 text-muted-foreground" />
        </dd>
      </div>
      <div class="flex flex-col gap-2">
        <dt class="readout text-muted-foreground">{t("close.phone")}</dt>
        <dd class="text-lg">
          <a href={telHref} class="inline-block py-3 hover:text-laser-ink">
            {business.phoneDisplay}
          </a>
          {" · "}
          <a
            href={`tel:${business.landline}`}
            class="inline-block py-3 hover:text-laser-ink"
          >
            {business.landlineDisplay}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>
