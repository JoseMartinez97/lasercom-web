  }
  .plaque-screw {
    position: absolute;
    width: 0.9em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #9aa1ac 70%);
    box-shadow: 0 0.08em 0.15em rgb(0 0 0 / 0.4);
  }
  /* Brushed stainless steel, as on the 3D plaque */
  .plaque {
    --gloss: 0.9;
    --face: linear-gradient(160deg, #eef1f4, #b9c0c9 55%, #9198a3);
    --back: #9198a3;
    --ink: #1d2026;
  }
  /* "Así trabajamos": with motion, the steps wait in grey for the laser
     line (animations.ts, animateBeams) and light up as it reaches them */
  .process-beam {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .process-beam {
      display: block;
    }
    :global(html.js) .process-beam [data-beam-fill] {
      transform: scaleY(0);
    }
    :global(html.js) .process-steps .process-num {
      color: var(--muted-foreground);
      transition:
        color 0.4s ease-out,
        text-shadow 0.6s ease-out;
    }
    :global(html.js) .process-steps [data-lit] .process-num {
      color: var(--laser-ink);
      text-shadow: 0 0 12px color-mix(in oklab, var(--laser) 55%, transparent);
    }
    :global(html.js) .process-steps h3 {
      opacity: 0.55;
      transition: opacity 0.5s ease-out;
    }
    :global(html.js) .process-steps [data-lit] h3 {
      opacity: 1;
    }
  }
  /* Stage running: one pinned scene under the header. The track is as tall
     as the scroll it takes: a screen for the scene to open, then 1.6 for the
     beam to engrave the piece. The script maps the same proportions */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stage-track {
      height: calc(100svh - 4rem + 260svh);
    }
    :global(html.js) .stage-pin {
      position: sticky;
      top: 4rem;
      height: calc(100svh - 4rem);
      min-height: 36rem;
      overflow: hidden;
    }
    :global(html.js) [data-stage-hero] {
      position: absolute;
      inset: 0;
    }
    :global(html.js) .stage-anchor {
      display: block;
      top: 106svh;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .plaque:not([data-js]) {
      animation: plaque-in 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.9s backwards;
    }
  }
  @keyframes plaque-in {
    from {
      opacity: 0;
      transform: translateY(40svh) rotate(6deg);
    }
  }
  .plaque {
    transition: opacity 0.5s ease-out;
  }
  .stage-view[data-gl] .plaque {
    opacity: 0;
  }
</style>

<script>
  import { ENGRAVE_ROWS as ROWS } from "@/lib/showcase"
  import type { DialedStage3D, StagePose } from "@/lib/monolith-3d"

  // Motion libraries after the first interaction (or just after load), so
  // they never compete with the first paint
  const motion = new Promise<void>((resolve) => {
    const events = ["scroll", "wheel", "pointerdown", "keydown", "touchstart"]
    const go = () => {
      events.forEach((e) => removeEventListener(e, go))
      resolve()
    }
    events.forEach((e) =>
      addEventListener(e, go, { once: true, passive: true })
    )
    const later = () => setTimeout(go, 350)
    if (document.readyState === "complete") later()
    else addEventListener("load", later, { once: true })
  }).then(async () => {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ])
    gsap.registerPlugin(ScrollTrigger)
    return { gsap, ScrollTrigger }
  })

  const clamp01 = (x: number) => Math.min(1, Math.max(0, x))
  const lerp = (a: number, b: number, k: number) => a + (b - a) * k
  const smooth = (x: number) => x * x * (3 - 2 * x)
  const easeInOut = (x: number) =>
    x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2

  // The scroll the stage takes, in screens (the track's height in the CSS):
  // one for the scene to open, then 1.6 for the beam to engrave the piece
  const OPEN = 1
  const ENGRAVE = 1.6
  // Where the scene has opened, as a share of the stage's scroll
  const OPENED = OPEN / (OPEN + ENGRAVE)

  const setup = ({
    gsap,
    ScrollTrigger,
  }: Awaited<typeof motion>): (() => void) => {
    const track = document.querySelector<HTMLElement>("[data-stage]")
    const pin = document.querySelector<HTMLElement>("[data-stage-pin]")
    const anchor = document.querySelector<HTMLElement>("[data-stage-anchor]")
    const view = document.querySelector<HTMLElement>("[data-stage-view]")
    const hero = document.querySelector<HTMLElement>("[data-stage-hero]")
    const showcase = document.querySelector<HTMLElement>("[data-showcase]")
    const plaque = document.querySelector<HTMLElement>("[data-plaque]")
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-stage-canvas]"
    )
    const last = document.querySelector<HTMLElement>("[data-hero-last]")
    if (
      !track ||
      !pin ||
      !anchor ||
      !view ||
      !hero ||
      !showcase ||
      !plaque ||
      !canvas ||
      !last
    )
      return () => {}
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return () => {}

    const cleanups: (() => void)[] = []
    const sheets = [...hero.querySelectorAll<HTMLElement>("[data-hero-sheet]")]
    const recede = hero.querySelector<HTMLElement>("[data-hero-recede]")
    const fades = [...hero.querySelectorAll<HTMLElement>("[data-hero-fade]")]
    const title = showcase.querySelector<HTMLElement>("[data-showcase-title]")
    const copy = showcase.querySelector<HTMLElement>(".showcase-copy")
    const sheet = showcase.querySelector<HTMLElement>("[data-engrave-sheet]")
    const after = showcase.querySelector<HTMLElement>("[data-engrave-after]")
    const status = showcase.querySelector<HTMLElement>("[data-engrave-status]")
    const label = status?.querySelector<HTMLElement>("[data-engrave-label]")
    const passes = showcase.querySelector<HTMLElement>("[data-engrave-passes]")
    const gantryX = showcase.querySelector<HTMLElement>("[data-gantry-x]")
    const gantryY = showcase.querySelector<HTMLElement>("[data-gantry-y]")
    const xyX = showcase.querySelector<HTMLElement>(
      "[data-engrave-xy] [data-x]"
    )
    const xyY = showcase.querySelector<HTMLElement>(
      "[data-engrave-xy] [data-y]"
    )
    const progress = showcase.querySelector<HTMLElement>(
      "[data-engrave-progress]"
    )

    // Links to #materiales land on the engraving, not on the hero
    showcase.removeAttribute("id")
    anchor.id = "materiales"
    cleanups.push(() => {
      anchor.removeAttribute("id")
      showcase.id = "materiales"
    })

    const chars = [
      ...showcase.querySelectorAll<HTMLElement>(".showcase-char"),
    ].map((el) => ({ el, c: Number(el.style.getPropertyValue("--c")) || 0 }))

    // The words around the piece, from the scene opening (`opened`) and the
    // engraving (`e`): the title rises letter by letter as the scene opens,
    // the job sheet follows, and the button waits for the finished piece
    let drawn = ""
    let state = ""
    const paint = (opened: number, e: number) => {
      const key = `${opened.toFixed(4)}:${e.toFixed(4)}`
      if (key === drawn) return
      drawn = key
      chars.forEach(({ el, c }) => {
        const y = clamp01((1 - opened) * (1 + c * 0.06))
        el.style.transform =
          y > 0
            ? `translate3d(0, ${(y * 115).toFixed(2)}%, 0) rotate(${(y * 4).toFixed(2)}deg)`
            : "none"
      })
      if (sheet) {
        const k = smooth(clamp01((opened - 0.35) / 0.65))
        sheet.style.opacity = k.toFixed(3)
        sheet.style.transform = `translate3d(0, ${((1 - k) * 1.25).toFixed(3)}rem, 0)`
      }
      if (after) {
        const k = smooth(clamp01((e - 0.82) / 0.18))
        after.style.opacity = k.toFixed(3)
        after.style.transform = `translate3d(0, ${((1 - k) * 1.25).toFixed(3)}rem, 0)`
        after.style.visibility = k <= 0 ? "hidden" : ""
      }
      if (progress) progress.style.transform = `scaleX(${e.toFixed(4)})`
      const now = e <= 0.001 ? "ready" : e >= 0.999 ? "done" : "burn"
      if (now !== state && status && label) {
        state = now
        status.dataset.state = now
        label.textContent = status.dataset[now] ?? ""
      }
      if (passes)
        passes.textContent = String(Math.min(ROWS, Math.ceil(e * ROWS - 1e-6)))
    }

    // The gantry: its two lines cross at the beam's spot (from the 3D scene,
    // or worked out on the CSS plaque) and the header reads its position in
    // millimetres of the bed (the grid is 3.2 px per mm)
    const MM = 3.2
    let gantryOn = 0
    let beamX = 0
    let beamY = 0
    const cssBeam = (pose: StagePose) => {
      if (pose.engrave <= 0.0005 || pose.engrave >= 0.9995) return null
      const s = pose.engrave * ROWS
      const row = Math.min(ROWS - 1, Math.floor(s))
      const along = s - row
      const u = row % 2 ? 1 - along : along
      const h = pose.height
      // The engraving spans 8–92% across and 9–92% down the face
      const dx = (0.08 + u * 0.84 - 0.5) * h * 0.8
      const dy = (0.09 + ((row + 0.5) / ROWS) * 0.83 - 0.5) * h
      const c = Math.cos(pose.rotZ)
      const sn = Math.sin(pose.rotZ)
      return { x: pose.cx + dx * c - dy * sn, y: pose.cy + dx * sn + dy * c }
    }
    const pad = (n: number) => Math.max(0, n).toFixed(1).padStart(5, "0")
    const moveGantry = (beam: { x: number; y: number } | null, dt: number) => {
      gantryOn += ((beam ? 1 : 0) - gantryOn) * (1 - Math.exp(-dt * 6))
      if (beam) {
        beamX = beam.x
        beamY = beam.y
      }
      const o = gantryOn < 0.01 ? "0" : gantryOn.toFixed(3)
      if (gantryX) {
        gantryX.style.opacity = o
        gantryX.style.transform = `translate3d(${beamX.toFixed(1)}px, 0, 0)`
      }
      if (gantryY) {
        gantryY.style.opacity = o
        gantryY.style.transform = `translate3d(0, ${beamY.toFixed(1)}px, 0)`
      }
      if (beam && xyX && xyY) {
        xyX.textContent = pad(beamX / MM)
        xyY.textContent = pad(beamY / MM)
      }
    }

    // Layout, measured on load and resize: the size of the scene, where the
    // headline's last line sits (the piece rises in front of its lower part,
    // as the can does in Dialed's hero) and, on phones, the gap between the
    // title and the copy, where the piece sits
    let vw = 0
    let vh = 0
    let titleBottom = 0
    let lineHeight = 0
    let baseH = 1
    let gapTop = 0
    let gapBottom = 0
    // Which way each sheet flies off as the scene opens
    let sheetDirs: [number, number][] = []
    const measure = () => {
      vw = view.clientWidth
      vh = view.clientHeight
      const held = recede?.style.transform ?? ""
      if (recede) recede.style.transform = ""
      const top = hero.getBoundingClientRect().top
      const box = last.getBoundingClientRect()
      titleBottom = box.bottom - top
      lineHeight = parseFloat(getComputedStyle(last).fontSize) * 0.9
      if (recede) recede.style.transform = held
      const box0 = showcase.getBoundingClientRect()
      gapTop = title ? title.getBoundingClientRect().bottom - box0.top : 0
      gapBottom = copy ? copy.getBoundingClientRect().top - box0.top : vh
      sheetDirs = sheets.map((s) => {
        const x = s.offsetLeft + s.offsetWidth / 2 - vw / 2
        const y = s.offsetTop + s.offsetHeight / 2 - vh / 2
        const d = Math.hypot(x, y) || 1
        return [x / d, y / d]
      })
      plaque.setAttribute("data-js", "")
      baseH = plaque.offsetHeight || 1
      stage3d?.resize()
    }

    const heroPose = () => {
      const desktop = vw >= 1024
      const h = desktop ? Math.min(vh * 0.6, 544) : Math.min(vh * 0.4, 288)
      const top = titleBottom - lineHeight * (desktop ? 0.08 : 0.05)
      return { cx: vw / 2, cy: top + h / 2, h }
    }

    const poseAt = (t: number, e: number): StagePose => {
      const desktop = vw >= 1024
      const k = easeInOut(clamp01(t))
      const from = heroPose()
      const gap = gapBottom - gapTop
      const showH = desktop
        ? Math.min(vh * 0.68, 600)
        : Math.max(120, Math.min(gap - 28, 280))
      return {
        cx: lerp(from.cx, desktop ? vw * 0.7 : vw / 2, k),
        cy: lerp(from.cy, desktop ? vh * 0.52 : (gapTop + gapBottom) / 2, k),
        height: lerp(from.h, showH, k),
        // Square to the reader by the time the beam starts
        rotZ: lerp(-0.035, desktop ? -0.05 : -0.02, k),
        // A full turn while the scene opens, from a three-quarter view to
        // the front; a slow drift while it engraves keeps it alive
        rotY: lerp(-0.24, 0, k) + k * Math.PI * 2 + (e - 0.5) * 0.12 * k,
        // The hero's piece is engraved; it turns its back and comes round
        // blank, ready for the beam
        engrave: k < 0.5 ? 1 : e,
      }
    }

    const applyCss = (pose: StagePose) => {
      const w = baseH * 0.8
      plaque.style.setProperty(
        "--sheen",
        Math.sin(pose.rotY * 0.5 + pose.rotZ * 4).toFixed(3)
      )
      plaque.style.setProperty("--engrave", pose.engrave.toFixed(4))
      plaque.style.setProperty(
        "--scan",
        pose.engrave > 0.001 && pose.engrave < 0.999 ? "1" : "0"
      )
      plaque.style.transform =
        `translate3d(${(pose.cx - w / 2).toFixed(1)}px, ${(pose.cy - baseH / 2).toFixed(1)}px, 0) ` +
        `rotate(${pose.rotZ.toFixed(4)}rad) rotateY(${pose.rotY.toFixed(4)}rad) ` +
        `scale(${(pose.height / baseH).toFixed(4)})`
    }

    // One scroll drives the whole scene: t opens it (0..1), e is how much
    // the beam has engraved (0..1), with a short rest before and after.
    // Both follow the scroll with a time-based glide
    let targetT = 0
    let targetE = 0
    let t = 0
    let e = 0
    const read = (p: number) => {
      targetT = clamp01(p / OPENED)
      targetE = clamp01(((p - OPENED) / (1 - OPENED) - 0.05) / 0.8)
    }
    const scene = ScrollTrigger.create({
      trigger: track,
      start: "top 64px",
      end: "bottom bottom",
      onUpdate: (self) => read(self.progress),
      onRefresh: (self) => read(self.progress),
    })
    // Leaving: the scene closes into a card as the stage lets go
    let exit = 0
    let exitS = 0
    const leave = ScrollTrigger.create({
      trigger: track,
      start: "bottom bottom",
      end: "bottom 45%",
      onUpdate: (self) => void (exit = self.progress),
    })
    cleanups.push(() => {
      scene.kill()
      leave.kill()
    })

    let stage3d: DialedStage3D | null = null
    // Hand-off: the plaque is already on screen (CSS, maybe still rising in);
    // the stage starts from where it is and eases into its own pose
    const start = (() => {
      const a = plaque.getBoundingClientRect()
      const v = view.getBoundingClientRect()
      return {
        cx: a.left + a.width / 2 - v.left,
        cy: a.top + a.height / 2 - v.top,
        h: a.height,
        at: performance.now(),
      }
    })()
    const HANDOFF = 1100
    let clipped = "-"
    const tick = (_time: number, deltaMs: number) => {
      // Frame-rate independent easing (the same glide at 60 and 120 Hz)
      const dt = Math.min(0.1, deltaMs / 1000)
      t += (targetT - t) * (1 - Math.exp(-dt * 7))
      e += (targetE - e) * (1 - Math.exp(-dt * 5))
      if (Math.abs(targetT - t) < 1e-4) t = targetT
      if (Math.abs(targetE - e) < 1e-4) e = targetE
      const pose = poseAt(t, e)
      // Leaving: the scene closes into a rounded card that slides away over
      // the next section, the piece settling smaller inside it
      exitS += (exit - exitS) * (1 - Math.exp(-dt * 8))
      const x = easeInOut(clamp01(exitS))
      pose.height *= 1 - 0.18 * x
      const h = clamp01((performance.now() - start.at) / HANDOFF)
      if (h < 1 && start.h > 0) {
        const k = 1 - easeInOut(h)
        pose.cx += (start.cx - pose.cx) * k
        pose.cy += (start.cy - pose.cy) * k
        pose.height += (start.h - pose.height) * k
      }
      if (stage3d) stage3d.setPose(pose)
      else applyCss(pose)
      moveGantry(stage3d ? stage3d.beam() : cssBeam(pose), dt)

      paint(smooth(clamp01((t - 0.55) / 0.45)), e)

      // The hero sinks back: the headline shrinks into the distance, the
      // rest fades, and the plans on the bench fly past the camera
      const k = easeInOut(clamp01(t))
      if (recede) {
        recede.style.transform =
          k > 0.001
            ? `translate3d(0, ${(-k * vh * 0.05).toFixed(1)}px, 0) scale(${(1 - k * 0.22).toFixed(4)})`
            : ""
        recede.style.opacity = k > 0.001 ? clamp01(1 - k * 1.3).toFixed(3) : ""
      }
      const fade = clamp01(1 - t * 2.6)
      fades.forEach((el) => {
        el.style.opacity = fade < 1 ? fade.toFixed(3) : ""
        el.style.visibility = fade <= 0 ? "hidden" : ""
      })
      sheets.forEach((s, i) => {
        const [dx, dy] = sheetDirs[i] ?? [0, 0]
        const d = Number(s.dataset.depth) || 1
        const fly = k * d
        s.style.translate =
          k > 0.001
            ? `${(dx * fly * vw * 0.35).toFixed(1)}px ${(dy * fly * vh * 0.35).toFixed(1)}px`
            : ""
        s.style.scale = k > 0.001 ? (1 + fly * 0.7).toFixed(4) : ""
        s.style.opacity = k > 0.001 ? clamp01(1 - k * 1.5).toFixed(3) : ""
      })

      // The scene opens out from behind the piece: a window the size of the
      // piece in the hero that grows, corners easing square, until it is
      // the whole screen
      const w = easeInOut(clamp01((t - 0.04) / 0.86))
      // "none", not "": the CSS keeps the scene shut until the script runs
      let clip = "none"
      if (x > 0.001) {
        const side = (x * vw * 0.04).toFixed(1)
        const r = (x * 44).toFixed(1)
        clip = `inset(0 ${side}px ${(x * vh * 0.06).toFixed(1)}px ${side}px round 0 0 ${r}px ${r}px)`
      } else if (w < 0.999) {
        const from = heroPose()
        const hw = from.h * 0.8 * 0.42
        const hh = from.h * 0.42
        const ins = (edge: number) => Math.max(0, edge * (1 - w)).toFixed(1)
        clip =
          `inset(${ins(from.cy - hh)}px ${ins(vw - from.cx - hw)}px ` +
          `${ins(vh - from.cy - hh)}px ${ins(from.cx - hw)}px ` +
          `round ${(28 * (1 - w)).toFixed(1)}px)`
      }
      if (clip !== clipped) {
        clipped = clip
        showcase.style.clipPath = clip
        showcase.style.visibility = t <= 0.04 ? "hidden" : ""
      }
    }
    measure()
    tick(0, 16)
    gsap.ticker.add(tick)
    cleanups.push(() => gsap.ticker.remove(tick))
    const ro = new ResizeObserver(measure)
    ro.observe(view)
    ro.observe(last)
    cleanups.push(() => ro.disconnect())

    // Arriving at /#materiales before the stage ran: go to the engraving
    // instead of the hero
    if (location.hash === "#materiales" && scene.progress < OPENED * 0.5)
      anchor.scrollIntoView()

    // Desktop: the real 3D piece, and the pointer moves it and the sheets
    const desktop = matchMedia("(min-width: 1024px) and (pointer: fine)")
    let destroyed = false
    if (desktop.matches) {
      void Promise.all([
        import("@/lib/monolith-3d"),
        document.fonts.ready,
      ]).then(async ([{ createDialedStage3D }]) => {
        if (destroyed) return
        const read = (key: string) => view.dataset[key] ?? ""
        // The CSS plaque carries on while the 3D one bakes
        const ready = await createDialedStage3D(canvas, {
          subtitle: read("plaqueSubtitle"),
          laser: read("plaqueLaser"),
          laserValue: read("plaqueLaserValue"),
          cut: read("plaqueCut"),
          since: read("plaqueSince"),
        })
        if (!ready) return
        if (destroyed) {
          ready.destroy()
          return
        }
        stage3d = ready
        stage3d.setPose(poseAt(t, e))
        view.setAttribute("data-gl", "")
        canvas.classList.remove("opacity-0")
      })
      const onMove = (ev: PointerEvent) => {
        const nx = (ev.clientX / innerWidth - 0.5) * 2
        const ny = (ev.clientY / innerHeight - 0.5) * 2
        stage3d?.setPointer(nx, ny)
        sheets.forEach((s) => {
          const inner = s.firstElementChild as HTMLElement | null
          const d = Number(s.dataset.depth) * 22
          if (inner)
            inner.style.transform = `translate3d(${(nx * d).toFixed(1)}px, ${(ny * d * 0.7).toFixed(1)}px, 0)`
        })
      }
      addEventListener("pointermove", onMove, { passive: true })
      cleanups.push(() => removeEventListener("pointermove", onMove))
    }
    cleanups.push(() => {
      destroyed = true
      stage3d?.destroy()
      stage3d = null
      view.removeAttribute("data-gl")
      plaque.removeAttribute("data-js")
      plaque.style.transform = ""
      ;["--sheen", "--engrave", "--scan"].forEach((v) =>
        plaque.style.removeProperty(v)
      )
      showcase.style.clipPath = ""
      showcase.style.visibility = ""
      chars.forEach(({ el }) => (el.style.transform = ""))
      if (status && label) {
        status.dataset.state = "done"
        label.textContent = status.dataset.done ?? ""
      }
      if (passes) passes.textContent = String(ROWS)
      ;[gantryX, gantryY].forEach((el) => {
        if (!el) return
        el.style.opacity = ""
        el.style.transform = ""
      })
      ;[sheet, after].forEach((el) => {
        if (!el) return
        el.style.opacity = ""
        el.style.transform = ""
        el.style.visibility = ""
      })
      if (progress) progress.style.transform = ""
      if (recede) {
        recede.style.transform = ""
        recede.style.opacity = ""
      }
      fades.forEach((el) => {
        el.style.opacity = ""
        el.style.visibility = ""
      })
      sheets.forEach((s) => {
        s.style.translate = ""
        s.style.scale = ""
        s.style.opacity = ""
      })
    })

    return () => cleanups.forEach((fn) => fn())
  }

  let cleanup: (() => void) | undefined
  let visit = 0
  document.addEventListener("astro:page-load", () => {
    cleanup?.()
    cleanup = undefined
    const current = ++visit
    void motion.then((libs) => {
      if (current === visit) cleanup = setup(libs)
    })
  })
  document.addEventListener("astro:before-swap", () => {
    visit++
    cleanup?.()
    cleanup = undefined
  })
</script>
