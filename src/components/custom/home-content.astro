<style>
  /* The CSS plaque: the piece on phones, with reduced motion and until the
     3D one is ready. --ph is its height; the script moves it with transforms
     (top-left origin) once the stage runs */
  .stage-view {
    perspective: 1600px;
  }
  .plaque {
    --ph: min(42svh, 18rem);
    position: absolute;
    left: 50%;
    top: 60%;
    width: calc(var(--ph) * 0.8);
    height: var(--ph);
    translate: -50% 0;
    rotate: -2deg;
    font-size: calc(var(--ph) / 31);
    transform-style: preserve-3d;
  }
  @media (min-width: 1024px) {
    .plaque {
      --ph: min(60svh, 34rem);
      top: 66%;
    }
  }
  .plaque[data-js] {
    left: 0;
    top: 0;
    translate: none;
    rotate: none;
    will-change: transform;
  }
  .plaque-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 9% 8% 8%;
    border-radius: 7%/5.6%;
    color: var(--ink);
    background: var(--face);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.45),
      inset 0 -0.35em 0 rgb(0 0 0 / 0.12),
      0 2.4em 4em -1.2em rgb(30 18 8 / 0.5);
    backface-visibility: hidden;
  }
  /* Light across the face: a soft band that slides as the piece turns
     (--sheen, set by the script from its angle) */
  .plaque-front::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / calc(var(--gloss, 0.3) * 0.9)) 47%,
      rgb(255 255 255 / calc(var(--gloss, 0.3) * 0.25)) 53%,
      transparent 70%
    );
    background-size: 250% 100%;
    background-position: calc(50% - var(--sheen, -0.6) * 60%) 0;
    mix-blend-mode: soft-light;
  }
  /* The beam on the CSS plaque: the engraving shows down to the line it
     has reached, and the line glows while it works */
  .plaque-ink {
    clip-path: inset(0 0 calc((1 - var(--engrave, 1)) * 100%) 0);
  }
  .plaque-scan {
    position: absolute;
    left: 6%;
    right: 6%;
    top: calc(9% + var(--engrave, 1) * 83%);
    height: 1.5px;
    border-radius: 1px;
    opacity: var(--scan, 0);
    background: oklch(0.95 0.06 70);
    box-shadow:
      0 0 0.5em 0.12em var(--laser),
      0 -1.4em 1.6em -0.6em color-mix(in oklab, var(--laser) 55%, transparent);
    pointer-events: none;
  }
  .plaque-back {
