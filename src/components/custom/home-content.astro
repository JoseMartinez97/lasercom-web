---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import CloseSection from "@/components/custom/close-section.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import GuideCards from "@/components/custom/guide-cards.astro"
import OpenStatus from "@/components/custom/open-status.astro"
import PlaqueHero from "@/components/custom/plaque-hero.astro"
import WorkShowcase from "@/components/custom/work-showcase.astro"
import { business } from "@/lib/business"
import { guideIds } from "@/lib/guides"
import { homeFaqIndices } from "@/lib/pages"
import { services, type ServiceId } from "@/lib/services"
import { ArrowRight, ArrowUpRight, Star } from "lucide-react"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)
const serviceHref = (id: ServiceId) =>
  lang === "en" ? services[id].en : services[id].es

const clientGroups: {
  num: string
  anchor: string
  title: string
  text: string
  ids: ServiceId[]
}[] = [
  {
    num: "01",
    anchor: "servicios-empresa",
    title: t("home.clients.business.title"),
    text: t("home.clients.business.text"),
    ids: ["industrial", "empresas", "letras"],
  },
  {
    num: "02",
    anchor: "servicios-particular",
    title: t("home.clients.people.title"),
    text: t("home.clients.people.text"),
    ids: ["bodas", "joyeria", "personalizado", "decoracion"],
  },
]

const processSteps = [1, 2, 3, 4] as const

const reviews = [
  { name: "Pau Pastor", text: t("home.reviews.1") },
  { name: "Lorena Tabuenca", text: t("home.reviews.2") },
  { name: "Olga Gomez", text: t("home.reviews.3") },
]

const faqs = homeFaqIndices.map((n) => ({
  q: t(`home.faq.${n}.q`),
  a: t(`home.faq.${n}.a`),
}))
---

<!-- =========================================================================
     ACT 1: FULL-VIEWPORT 3D ENGRAVED LASERCOM PLAQUE HERO
     Brushed stainless steel plaque rastered live across 56 fibre-laser passes
     as the visitor scrolls (GSAP ScrollTrigger pin on desktop, sticky on mobile).
     ========================================================================= -->
<PlaqueHero lang={lang} />

<!-- =========================================================================
     SOLID OBSIDIAN STAGE
     Real Work -> Hairline Services -> Laser Beam Steps -> Proof & Closing
     ========================================================================= -->
<div class="relative z-10 border-t border-border bg-background">
  <!-- ACT 2: PINNED HORIZONTAL CINEMA FILMSTRIP OF REAL WORK -->
  <WorkShowcase lang={lang} />

  <!-- KINETIC DUAL-TRACK SCROLL MARQUEE (opposing scroll-scrubbed statement) -->
  <div
    aria-hidden="true"
    class="overflow-hidden border-t border-border bg-background py-12 select-none lg:py-16"
  >
    <div
      data-marquee-track="-1"
      class="display flex w-max items-center gap-8 whitespace-nowrap text-[clamp(2.5rem,7vw,6.25rem)] leading-none tracking-[-0.04em] text-foreground/90 will-change-transform"
    >
      <span>
        {t("home.h1.1")} {t("home.h1.2")}
      </span>
      <span class="text-laser">·</span>
      <span>{t("home.plaque.laserValue")}</span>
      <span class="text-laser">·</span>
      <span>VALENCIA · {business.founded}</span>
      <span class="text-laser">·</span>
      <span>
        {t("home.h1.1")} {t("home.h1.2")}
      </span>
    </div>
    <div
      data-marquee-track="1"
      class="display mt-3 flex w-max items-center gap-8 whitespace-nowrap text-[clamp(2.5rem,7vw,6.25rem)] leading-none tracking-[-0.04em] text-transparent [-webkit-text-stroke:1px_rgba(243,242,238,0.28)] will-change-transform"
    >
      <span>{t("bench.m.acero.name")}</span>
      <span>·</span>
      <span>{t("bench.m.madera.name")}</span>
      <span>·</span>
      <span>{t("bench.m.laton.name")}</span>
      <span>·</span>
      <span>{t("bench.m.cristal.name")}</span>
      <span>·</span>
      <span>{t("bench.m.piel.name")}</span>
      <span>·</span>
      <span>{t("bench.m.metacrilato.name")}</span>
    </div>
  </div>

  <!-- ACT 3: TWO AUDIENCES — ARCHITECTURAL HAIRLINE ROWS -->
  <section
    id="servicios"
    data-rows
    data-cinema-section
    class="obsidian-ember scroll-mt-16 border-t border-border px-5 py-24 md:px-8 lg:px-12 lg:py-32"
  >
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7" data-cinema-drift="22">
          <h2
            data-title-chars
            class="display max-w-[16ch] text-[clamp(1.95rem,5.5vw,4.75rem)] text-foreground"
          >
            {t("home.clients.title")}
          </h2>
        </div>
        <div class="lg:col-span-5 lg:justify-self-end">
          <a
            href={`${href("/contacto/")}#presupuesto`}
            class="roll-link group inline-flex min-h-11 items-center gap-2 pb-1.5 text-sm font-semibold text-foreground"
          >
            <span class="roll-link-mask">
              <span>{t("home.process.cta")}</span>
              <span aria-hidden="true">{t("home.process.cta")}</span>
            </span>
            <ArrowRight
              className="size-4 text-laser-ink transition-transform group-hover:translate-x-1"
              aria-hidden
            />
          </a>
        </div>
      </div>

      <div class="mt-14 grid gap-14 lg:grid-cols-2 lg:gap-16">
        {clientGroups.map((group) => (
          <div id={group.anchor} class="flex flex-col gap-6">
            <div class="flex flex-col gap-3">
              <span data-scramble class="readout text-laser-ink">
                {group.num}
              </span>
              <h3 class="display text-2xl text-foreground md:text-3xl">
                {group.title}
              </h3>
              <p class="max-w-lg text-sm leading-relaxed text-muted-foreground md:text-base">
                {group.text}
              </p>
            </div>
            <ul class="flex flex-col">
              {group.ids.map((id, rowIdx) => (
                <li data-row class="relative">
                  <span
                    data-row-line
                    aria-hidden="true"
                    class="block h-px w-full origin-left bg-border"
                  ></span>
                  <a
                    href={serviceHref(id)}
                    class="group flex items-center justify-between gap-4 py-5 transition-colors hover:text-laser-ink"
                  >
                    <span class="flex items-baseline gap-4">
                      <span data-row-cell class="readout text-muted-foreground">
                        0{rowIdx + 1}
                      </span>
                      <span
                        data-row-cell
                        class="text-lg font-medium text-foreground transition-colors group-hover:text-laser-ink md:text-xl"
                      >
                        {t(`svc.${id}.name`)}
                      </span>
                    </span>
                    <ArrowRight
                      data-row-cell
                      className="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-1 group-hover:text-laser-ink"
                      aria-hidden
                    />
                  </a>
                </li>
              ))}
              <li aria-hidden="true" class="h-px w-full bg-border"></li>
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ACT 6: LASER BEAM PROCESS ([data-beam-track] lights up each step) -->
  <section
    data-cinema-section
    class="steel-rings border-t border-border bg-background px-5 py-24 md:px-8 lg:px-12 lg:py-32"
  >
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12">
      <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
        <h2
          data-title-chars
          class="display text-[clamp(1.95rem,5.5vw,4.5rem)] text-foreground"
        >
          {t("home.process.title")}
        </h2>
        <p
          data-lines
          class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground"
        >
          {t("home.reviews.workshop.text")}
        </p>
      </div>

      <div data-beam-track class="relative pl-8 sm:pl-12 lg:col-span-7">
        <!-- Vertical laser guide track -->
        <div
          aria-hidden="true"
          class="absolute top-2 bottom-2 left-2 w-px bg-border sm:left-3"
        >
          <div
            data-beam-fill
            class="size-full origin-top scale-y-0 bg-laser shadow-[0_0_12px_var(--laser)]"
          ></div>
          <span
            data-beam-head
            class="absolute top-0 left-1/2 size-2.5 rounded-full bg-[#ffd7b0] opacity-0 shadow-[0_0_16px_4px_var(--laser)]"
          ></span>
        </div>

        <ol class="flex flex-col gap-12">
          {processSteps.map((step) => (
            <li
              data-beam-step
              class="beam-step flex flex-col gap-2.5 border-b border-border/60 pb-10 transition-opacity duration-500 last:border-b-0 last:pb-0"
            >
              <span class="readout text-laser-ink">0{step}</span>
              <h3 class="display text-2xl text-foreground md:text-3xl">
                {t(`home.process.${step}.t`)}
              </h3>
              <p class="max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
                {t(`home.process.${step}.d`)}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ACT 7: VERIFIED PROOF, GUIDES & FAQ ON TEXTURED OBSIDIAN GRID -->
  <div class="obsidian-grid border-t border-border">
    <section
      data-cinema-section
      class="reveal px-5 py-24 md:px-8 lg:px-12 lg:py-28"
    >
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div data-cinema-drift="18">
            <p class="readout inline-flex items-center gap-2 text-muted-foreground">
              <Star className="size-3.5 fill-laser text-laser" aria-hidden />
              {t("home.reviews.summary")} · {t("home.reviews.count")}
            </p>
            <h2
              data-title-chars
              class="display mt-3 text-[clamp(1.85rem,5vw,4.25rem)] text-foreground"
            >
              {t("home.reviews.title")}
            </h2>
          </div>
          <a
            href={business.mapsUrl}
            target="_blank"
            rel="noopener"
            class="roll-link group inline-flex min-h-11 w-fit items-center gap-2 pb-1 text-sm font-semibold text-foreground"
          >
            <span class="roll-link-mask">
              <span>{t("home.reviews.link")}</span>
              <span aria-hidden="true">{t("home.reviews.link")}</span>
            </span>
            <ArrowUpRight className="size-4 text-laser-ink" aria-hidden />
          </a>
        </div>

        <!-- Oversized typographic quotes on hairlines instead of a card grid -->
        <div class="mt-14 border-b border-border" data-stagger>
          {reviews.map((review) => (
            <figure class="grid gap-5 border-t border-border py-10 md:py-12 lg:grid-cols-12 lg:gap-10">
              <blockquote class="display relative text-[clamp(1.45rem,2.6vw,2.4rem)] leading-[1.18] tracking-[-0.02em] text-foreground lg:col-span-9">
                <span aria-hidden="true" class="text-laser">
                  “
                </span>
                {review.text}
                <span aria-hidden="true" class="text-laser">
                  ”
                </span>
              </blockquote>
              <figcaption class="flex items-center gap-3 lg:col-span-3 lg:flex-col lg:items-end lg:justify-end lg:text-right">
                <span class="text-sm font-semibold text-foreground">
                  {review.name}
                </span>
                <span class="readout text-muted-foreground">Google</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <!-- Workshop status strip -->
        <div class="mt-8 flex flex-col justify-between gap-5 rounded-2xl border border-border bg-card p-6 md:flex-row md:items-center md:p-8">
          <div class="flex flex-col gap-1.5">
            <p data-scramble class="readout text-laser-ink">
              {t("home.reviews.workshop.label")}
            </p>
            <p class="text-lg font-semibold text-foreground">
              {t("home.reviews.workshop.title")}
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-1.5 md:items-end">
            <OpenStatus lang={lang} class="text-foreground/85" />
            <span class="text-xs text-muted-foreground">
              {t("home.reviews.workshop.note")}
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="reveal border-t border-border px-5 py-20 md:px-8 lg:px-12 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <GuideCards lang={lang} ids={guideIds} />
      </div>
    </section>

    <FaqSection title={t("home.faq.title")} faqs={faqs} />
  </div>

  <CloseSection lang={lang} />
</div>

<style>
  /* Steps dim slightly until the vertical laser beam reaches them */
  @media (prefers-reduced-motion: no-preference) {
    .js .beam-step {
      opacity: 0.36;
    }
    .js .beam-step[data-lit] {
      opacity: 1;
    }
  }
</style>
