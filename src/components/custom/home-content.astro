---
import { Image } from "astro:assets"
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import { LogoMark } from "@/components/custom/logo"
import CloseSection from "@/components/custom/close-section.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import BenchTeaser from "@/components/custom/bench-teaser.astro"
import benchStill from "@/assets/bench/acero.jpg"
import WorkCurtains from "@/components/custom/work-curtains.astro"
import OpenStatus from "@/components/custom/open-status.astro"
import GuideCards from "@/components/custom/guide-cards.astro"
import { business, whatsappHref } from "@/lib/business"
import { guideIds } from "@/lib/guides"
import { homeFaqIndices } from "@/lib/pages"
import { photo, services, type ServiceId } from "@/lib/services"
import { cn } from "@/lib/utils"
import { ArrowRight, ArrowUpRight, Star } from "lucide-react"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)
const serviceHref = (id: ServiceId) =>
  lang === "en" ? services[id].en : services[id].es

const clientGroups: {
  anchor: string
  title: string
  text: string
  ids: ServiceId[]
}[] = [
  {
    anchor: "servicios-empresa",
    title: t("home.clients.business.title"),
    text: t("home.clients.business.text"),
    ids: ["industrial", "empresas", "letras"],
  },
  {
    anchor: "servicios-particular",
    title: t("home.clients.people.title"),
    text: t("home.clients.people.text"),
    ids: ["bodas", "joyeria", "personalizado", "decoracion"],
  },
]

const processSteps = [1, 2, 3, 4] as const

const reviews = [
  { name: "Pau Pastor", text: t("home.reviews.1") },
  { name: "Lorena Tabuenca", text: t("home.reviews.2") },
  { name: "Olga Gomez", text: t("home.reviews.3") },
]
const faqs = homeFaqIndices.map((n) => ({
  q: t(`home.faq.${n}.q`),
  a: t(`home.faq.${n}.a`),
}))

// The cutting plans that drift behind the hero headline, out of focus (the
// sheets of paper in Dialed's hero). Each is a laser job's file: cut lines in
// the beam's colour, engraving in ink. depth: how far it travels with the
// scroll and the pointer
const gearPath = (cx: number, cy: number, ro: number, ri: number, n = 14) =>
  Array.from({ length: n * 4 }, (_, i) => {
    const a = (i * Math.PI * 2) / (n * 4)
    const r = i % 4 < 2 ? ro : ri
    return `${i ? "L" : "M"}${(cx + Math.cos(a) * r).toFixed(1)} ${(cy + Math.sin(a) * r).toFixed(1)}`
  }).join("") + "Z"
const heroSheets = [
  {
    kind: "gear",
    cls: "top-[13%] left-[3%] w-44 -rotate-[14deg] sm:w-60",
    blur: 1.5,
    depth: 1,
  },
  {
    kind: "plate",
    cls: "top-[18%] right-[5%] w-48 rotate-[11deg] sm:w-64",
    blur: 1.8,
    depth: 1.2,
  },
  {
    kind: "mark",
    cls: "bottom-[16%] left-[9%] w-40 rotate-[8deg] sm:w-52",
    blur: 3,
    depth: 0.6,
  },
  {
    kind: "ring",
    cls: "bottom-[12%] right-[12%] w-40 -rotate-[10deg] sm:w-56",
    blur: 2.6,
    depth: 0.7,
  },
] as const
---

<!-- 1–2. THE STAGE (after Dialed Coffee and savvia.studio): one pinned
     scene. The piece stands in front of the hero headline; as the visitor
     scrolls, the hero sinks back, the engraving scene (#materiales) opens
     out from behind the piece and the beam engraves it row by row. 3D on
     desktop (src/lib/monolith-3d.ts), the CSS plaque below everywhere else.
     Without JavaScript or with reduced motion the hero and the scene simply
     follow each other. The choreography is the script at the end of this
     file -->
<div data-stage class="stage-track relative">
  <!-- Where links to #materiales land while the stage runs (the script
       moves the id here): the engraving scene, once it has opened -->
  <span
    data-stage-anchor
    aria-hidden="true"
    class="stage-anchor pointer-events-none absolute left-0 hidden h-px w-px scroll-mt-16"
  ></span>
  <div data-stage-pin class="stage-pin relative">
    <div
      data-stage-view
      data-plaque-subtitle={`${t("home.h1.1")} ${t("home.h1.2")}`}
      data-plaque-laser={t("home.plaque.laser")}
      data-plaque-laser-value={t("home.plaque.laserValue")}
      data-plaque-cut={t("home.plaque.cut")}
      data-plaque-since={t("home.plaque.since")}
      aria-hidden="true"
      class="stage-view pointer-events-none absolute inset-x-0 top-0 z-20 h-[calc(100svh-4rem)] min-h-[36rem] overflow-hidden"
    >
      <div data-plaque class="plaque">
        <div class="plaque-face plaque-front">
          <span class="plaque-screw left-[6%] top-[5%]"></span>
          <span class="plaque-screw right-[6%] top-[5%]"></span>
          <span class="plaque-screw bottom-[5%] left-[6%]"></span>
          <span class="plaque-screw right-[6%] bottom-[5%]"></span>
          <!-- The engraving: the script reveals it row by row (--engrave)
               under the beam's line (--scan) -->
          <div class="plaque-ink flex flex-1 flex-col">
            <div class="plaque-rule flex justify-between border-b pb-[2%] font-mono text-[0.55em] tracking-wider">
              <span>RIBA-ROJA DE TÚRIA · VALENCIA</span>
              <span>2007</span>
            </div>
            <div class="plaque-rule mx-auto my-[7%] flex aspect-square w-[52%] items-center justify-center rounded-full border">
              <LogoMark className="plaque-mark w-[46%]" />
            </div>
            <p class="display text-center text-[2.6em] leading-none">
              LASERCOM
            </p>
            <p class="mt-[2%] text-center font-mono text-[0.62em] tracking-[0.2em] uppercase">
              {t("home.h1.1")} {t("home.h1.2")}
            </p>
            <div class="plaque-rule mt-auto grid grid-cols-3 border font-mono text-[0.5em] uppercase">
              {[
                [t("home.plaque.laser"), t("home.plaque.laserValue")],
                [t("home.plaque.cut"), "4 mm"],
                [t("home.plaque.since"), String(business.founded)],
              ].map(([label, value], i) => (
                <span
                  class={cn(
                    "plaque-rule flex flex-col gap-[0.4em] p-[0.9em]",
                    i && "border-l"
                  )}
                >
                  <span class="opacity-70">{label}</span>
                  <span class="font-bold">{value}</span>
                </span>
              ))}
            </div>
          </div>
          <span class="plaque-scan"></span>
        </div>
        <div class="plaque-face plaque-back"></div>
      </div>
      <canvas
        data-stage-canvas
        class="absolute inset-0 size-full opacity-0 transition-opacity duration-500"
      ></canvas>
    </div>

    <section
      data-stage-hero
      class="relative flex h-[calc(100svh-4rem)] min-h-[36rem] flex-col overflow-hidden px-5 pt-5 pb-[calc(4.75rem+env(safe-area-inset-bottom))] md:px-8 md:pb-5 lg:px-12 lg:pb-7"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        {heroSheets.map((s) => (
          <div
            data-hero-sheet
            data-depth={s.depth}
            class={cn("absolute", s.cls)}
          >
            <div
              data-sheet-inner
              class="aspect-[1.45/1] rounded-[3px] bg-[#fbf7f0] p-3 shadow-[0_24px_50px_-20px_rgb(60_40_20/0.35)]"
              style={`filter: blur(${s.blur}px)`}
            >
              <div class="flex justify-between border-b border-foreground/15 pb-1 font-mono text-[8px] tracking-wider text-foreground/50 uppercase">
                <span>{s.kind}.dxf</span>
                <span>1:1</span>
              </div>
              <svg
                viewBox="0 0 160 90"
                fill="none"
                class="mt-1.5 w-full"
                stroke-linejoin="round"
              >
                {s.kind === "gear" && (
                  <g stroke="var(--laser)" stroke-width="1">
                    <path d={gearPath(56, 45, 36, 30)} />
                    <circle cx="56" cy="45" r="10" />
                    <path d={gearPath(124, 34, 20, 16, 10)} />
                    <circle cx="124" cy="34" r="5" />
                  </g>
                )}
                {s.kind === "plate" && (
                  <g>
                    <rect
                      x="14"
                      y="10"
                      width="132"
                      height="70"
                      rx="6"
                      stroke="var(--laser)"
                    />
                    {[
                      [24, 20],
                      [136, 20],
                      [24, 70],
                      [136, 70],
                    ].map(([x, y]) => (
                      <circle cx={x} cy={y} r="3" stroke="var(--laser)" />
                    ))}
                    <g
                      stroke="currentColor"
                      class="text-foreground/45"
                      stroke-width="2.5"
                    >
                      <path d="M44 38h72M54 50h52M64 60h32" />
                    </g>
                  </g>
                )}
                {s.kind === "mark" && (
                  <g
                    stroke="var(--laser)"
                    stroke-width="1.2"
                    transform="translate(52 6) scale(0.19)"
                  >
                    <rect x="48" y="25" width="97" height="313" />
                    <path d="M145 338 222 265H400L323 338Z" />
                  </g>
                )}
                {s.kind === "ring" && (
                  <g stroke="var(--laser)">
                    <circle cx="80" cy="45" r="38" />
                    <circle cx="80" cy="45" r="17" />
                    {[0, 1, 2, 3, 4, 5].map((i) => (
                      <circle
                        cx={(80 + Math.cos((i * Math.PI) / 3) * 28).toFixed(1)}
                        cy={(45 + Math.sin((i * Math.PI) / 3) * 28).toFixed(1)}
                        r="3.5"
                      />
                    ))}
                  </g>
                )}
              </svg>
            </div>
          </div>
        ))}
      </div>

      <div
        data-hero-fade
        class="hero-in relative z-30 flex items-center justify-between gap-4"
        style="--i: 0"
      >
        <p class="readout flex items-center gap-2.5 text-laser-ink">
          <span class="beam-dot inline-block size-2 rounded-full bg-laser shadow-[0_0_10px_var(--laser)]"></span>
          <span>{t("home.readout")}</span>
        </p>
        <div class="readout hidden items-center gap-3 text-muted-foreground md:flex">
          <span>{lang === "es" ? "4,5" : "4.5"} ★ Google</span>
          <span aria-hidden="true">·</span>
          <OpenStatus lang={lang} />
        </div>
      </div>

      <div
        data-hero-recede
        class="relative z-10 flex flex-1 items-start justify-center pt-[9svh] lg:pt-[11svh]"
      >
        <h1
          data-hero-title
          class="display text-center text-[clamp(2.6rem,min(7.6vw,15svh),9.5rem)] leading-[0.9] text-balance"
        >
          <span class="engrave mx-auto" style="--i: 0">
            <span class="engrave-text">{t("home.h1.1")}</span>
          </span>
          <span data-hero-last class="engrave mx-auto" style="--i: 1">
            <span class="engrave-text">
              {t("home.h1.2")}{" "}
              <span class="text-laser-ink">{t("home.h1.3")}</span>
            </span>
          </span>
        </h1>
      </div>

      <div
        data-hero-fade
        class="relative z-30 grid items-end gap-6 lg:grid-cols-[minmax(0,26rem)_1fr_minmax(0,22rem)]"
      >
        <div class="hero-in flex flex-col gap-5" style="--i: 2">
          <p class="hidden text-[0.9375rem] leading-relaxed text-foreground/80 lg:block">
            {t("home.lead")}
          </p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <a
              href={`${href("/contacto/")}#presupuesto`}
              data-magnetic
              class={buttonVariants({
                size: "lg",
                className: "h-12 rounded-full px-6 text-base font-semibold",
              })}
            >
              {t("cta.quote")}
              <ArrowRight className="size-4" aria-hidden />
            </a>
            <a
              href={whatsappHref(t("wa.default"))}
              target="_blank"
              rel="noopener"
              class="roll-link hidden min-h-11 items-center gap-1.5 pb-1.5 text-base font-semibold sm:inline-flex"
            >
              <span class="roll-link-mask">
                <span>{t("cta.whatsapp.short")}</span>
                <span aria-hidden="true">{t("cta.whatsapp.short")}</span>
              </span>
              <ArrowUpRight className="size-4 text-laser-ink" aria-hidden />
            </a>
          </div>
        </div>
        <a
          href={href("/prueba-tu-grabado/")}
          class="hero-in group col-start-3 hidden items-center gap-4 rounded-md bg-card/90 p-2 pr-4 shadow-[0_24px_50px_-24px_rgb(60_40_20/0.45)] backdrop-blur-sm transition-transform duration-300 hover:-translate-y-0.5 lg:flex"
          style="--i: 3"
        >
          <Image
            src={benchStill}
            alt=""
            widths={[160, 240]}
            sizes="80px"
            class="size-20 shrink-0 rounded-[3px] object-cover"
          />
          <span class="flex min-w-0 flex-col gap-1">
            <span class="readout text-laser-ink">{t("bench.readout")}</span>
            <span class="leading-snug font-semibold">
              {t("bench.teaser.title")}
            </span>
            <span class="inline-flex items-center gap-1 text-sm text-muted-foreground group-hover:text-foreground">
              {t("bench.teaser.cta")}
              <ArrowRight className="size-3.5" aria-hidden />
            </span>
          </span>
        </a>
      </div>
    </section>

    <BenchTeaser lang={lang} />
  </div>
</div>
<!-- 3. THE PIECES: real work opening like a cut -->
<WorkCurtains lang={lang} />
<!-- 4. PROOF: what Google says, at headline size, right after the work -->
<section
  aria-labelledby="reviews-title"
  class="steel steel-rings px-5 py-20 md:px-8 lg:px-12 lg:py-32"
>
  <h2 id="reviews-title" class="sr-only">
    {t("home.reviews.title")}
  </h2>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex items-end gap-4">
      <span class="display text-[clamp(5rem,13vw,11rem)] leading-[0.8] tabular-nums">
        {lang === "es" ? "4,5" : "4.5"}
      </span>
      <span class="flex flex-col gap-1.5 pb-1">
        <span class="flex gap-0.5" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => (
            <Star
              className={cn(
                "size-6",
                i < 4 ? "fill-laser text-laser" : "fill-laser/50 text-laser"
              )}
            />
          ))}
        </span>
        <span class="readout text-muted-foreground">
          {t("home.reviews.summary")} · {t("home.reviews.count")}
        </span>
      </span>
    </div>
    <a
      href={business.mapsUrl}
      target="_blank"
      rel="noopener"
      class="roll-link inline-flex min-h-11 w-fit items-center gap-2 pb-1.5 text-laser-ink"
    >
      <span class="roll-link-mask">
        <span>{t("home.reviews.link")}</span>
        <span aria-hidden="true">{t("home.reviews.link")}</span>
      </span>
      <ArrowUpRight className="size-4" aria-hidden />
    </a>
  </div>

  <div class="mt-12 grid gap-12 border-t border-white/15 pt-12 lg:grid-cols-12 lg:gap-16">
    <figure class="flex flex-col gap-6 lg:col-span-7">
      <blockquote
        data-lines
        class="text-[clamp(1.5rem,2.7vw,2.5rem)] leading-[1.18] font-semibold tracking-tight text-balance"
      >
        “{reviews[1].text}”
      </blockquote>
      <figcaption class="readout text-muted-foreground">
        {reviews[1].name} · Google
        {t("home.reviews.translated") && ` · ${t("home.reviews.translated")}`}
      </figcaption>
    </figure>
    <ul class="flex flex-col gap-10 lg:col-span-5" data-stagger>
      {[reviews[0], reviews[2]].map(({ name, text }) => (
        <li class="flex flex-col gap-4 border-t border-white/15 pt-6">
          <p class="text-lg leading-relaxed text-foreground/90">“{text}”</p>
          <p class="readout text-muted-foreground">
            {name} · Google
            {t("home.reviews.translated") &&
              ` · ${t("home.reviews.translated")}`}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
<!-- 4b. WHO IT IS FOR: two audiences, one directory -->
<section
  id="servicios"
  class="scroll-mt-16 border-t border-border px-5 py-24 md:px-8 lg:px-12 lg:py-36"
>
  <h2
    class="display mb-14 max-w-[16ch] text-[clamp(2.75rem,7vw,6rem)]"
    data-title-chars
  >
    {t("home.clients.title")}
  </h2>
  <div class="grid gap-16 lg:grid-cols-2 lg:gap-12">
    {clientGroups.map((group) => (
      <div id={group.anchor} class="flex scroll-mt-20 flex-col gap-6" data-rows>
        <div class="flex flex-col gap-2">
          <h3 class="text-2xl font-bold tracking-tight md:text-3xl">
            {group.title}
          </h3>
          <p class="max-w-lg text-muted-foreground">{group.text}</p>
        </div>
        <ul class="border-b border-border">
          {group.ids.map((id) => (
            <li data-row class="relative">
              <span
                data-row-line
                class="absolute inset-x-0 top-0 h-px origin-left bg-border"
              />
              <a
                href={serviceHref(id)}
                data-cursor={t("cursor.service")}
                class="group flex items-center justify-between gap-4 py-5 transition-[padding] duration-500 ease-out hover:pl-3"
              >
                <span class="flex min-w-0 flex-col gap-1">
                  <span
                    data-row-cell
                    class="text-xl font-semibold tracking-tight transition-colors group-hover:text-laser-ink md:text-2xl"
                  >
                    {t(`svc.${id}.name`)}
                  </span>
                  <span
                    data-row-cell
                    class="text-sm text-muted-foreground md:text-base"
                  >
                    {t(`svc.${id}.card`)}
                  </span>
                </span>
                <ArrowRight className="size-5 shrink-0 text-laser-ink transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<!-- 4c. FROM MESSAGE TO PIECE: the workshop as it is, and the four steps -->
<section
  id="proceso"
  class="scroll-mt-16 border-t border-border px-5 py-24 md:px-8 lg:px-12 lg:py-36"
>
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="flex flex-col gap-6 lg:col-span-5">
      <div
        data-wipe
        class="relative aspect-[4/3] overflow-hidden rounded-[22px] lg:aspect-[4/5]"
      >
        <Image
          src={photo("fachada_lasercom")}
          alt={t("photo.fachada_lasercom")}
          widths={[640, 960, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="flex flex-col gap-3">
        <p data-scramble class="readout text-laser-ink">
          {t("home.reviews.workshop.label")}
        </p>
        <p class="text-xl font-semibold tracking-tight">
          {t("home.reviews.workshop.title")}
        </p>
        <p class="max-w-md text-muted-foreground">
          {t("home.reviews.workshop.text")}
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <a
            href={business.mapsUrl}
            target="_blank"
            rel="noopener"
            class="roll-link inline-flex min-h-11 items-center gap-1.5 pb-1.5 font-semibold"
          >
            <span class="roll-link-mask">
              <span>{t("cta.directions")}</span>
              <span aria-hidden="true">{t("cta.directions")}</span>
            </span>
            <ArrowUpRight className="size-4 text-laser-ink" aria-hidden />
          </a>
          <span class="readout text-muted-foreground">
            {t("home.reviews.workshop.note")}
          </span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7" data-rows>
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6 lg:mb-14">
        <h2 class="display text-[clamp(2.75rem,7vw,6rem)]" data-title-chars>
          {t("home.process.title")}
        </h2>
      </div>

      <ol data-beam-track class="process-steps relative border-b border-border">
        <span
          data-beam
          aria-hidden="true"
          class="process-beam pointer-events-none absolute top-0 bottom-0 -left-3 w-px md:-left-6"
        >
          <span
            data-beam-fill
            class="absolute inset-0 origin-top bg-laser/70 shadow-[0_0_8px_var(--laser)]"
          ></span>
          <span
            data-beam-head
            class="absolute top-0 left-1/2 size-2 rounded-full bg-[oklch(0.95_0.07_70)] opacity-0 shadow-[0_0_10px_3px_var(--laser),0_0_28px_8px_color-mix(in_oklab,var(--laser)_50%,transparent)]"
          ></span>
        </span>
        {processSteps.map((n) => (
          <li
            data-row
            data-beam-step
            class="group relative grid gap-2 py-6 md:grid-cols-7 md:gap-6 lg:py-8"
          >
            <div
              data-row-line
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-px origin-left bg-border"
            />
            <span
              data-row-cell
              aria-hidden="true"
              class="process-num font-mono text-base text-laser-ink tabular-nums md:col-span-1"
            >
              {String(n).padStart(3, "0")}
            </span>
            <h3
              data-row-cell
              class="text-xl font-semibold tracking-tight transition-[translate] duration-500 ease-out group-hover:translate-x-2 md:col-span-2 lg:text-2xl"
            >
              {t(`home.process.${n}.t`)}
            </h3>
            <p
              data-row-cell
              class="text-base text-muted-foreground transition-colors duration-300 group-hover:text-foreground md:col-span-4 lg:text-lg"
            >
              {t(`home.process.${n}.d`)}
            </p>
          </li>
        ))}
      </ol>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={`${href("/contacto/")}#presupuesto`}
          class={buttonVariants({
            size: "lg",
            className: "h-12 rounded-full px-6 text-base",
          })}
        >
          {t("home.process.cta")}
          <ArrowRight className="size-4" aria-hidden />
        </a>
      </div>
    </div>
  </div>
</section>
<!-- 6. THE WAY IN: guides, FAQ and the closing panel -->
