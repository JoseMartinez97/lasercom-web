<script>
  import type { gsap as Gsap } from "gsap"
  import type { ScrollTrigger as ScrollTriggerType } from "gsap/ScrollTrigger"

  // GSAP stays out of the first paint: it loads once the page has settled or
  // the visitor moves, like the rest of the motion (see layouts/main.astro)
  const motion = new Promise<void>((resolve) => {
    const events = ["scroll", "wheel", "pointerdown", "keydown", "touchstart"]
    const go = () => {
      events.forEach((e) => removeEventListener(e, go))
      resolve()
    }
    events.forEach((e) =>
      addEventListener(e, go, { once: true, passive: true })
    )
    const later = () => setTimeout(go, 800)
    if (document.readyState === "complete") later()
    else addEventListener("load", later, { once: true })
  }).then(async () => {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ])
    gsap.registerPlugin(ScrollTrigger)
    return { gsap, ScrollTrigger }
  })

  const setupHomeInteractive = ({
    gsap,
    ScrollTrigger,
  }: {
    gsap: typeof Gsap
    ScrollTrigger: typeof ScrollTriggerType
  }) => {
    const cleanups: (() => void)[] = []
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

    // 1. Pinned Iris Portal Film Hero (Dimeunrestaurante lens shrink + Cepa scrubbed video)
    const filmSection = document.querySelector<HTMLElement>("[data-film]")
    const filmStage = document.querySelector<HTMLElement>("[data-film-stage]")
    const filmMedia = document.querySelector<HTMLElement>("[data-film-media]")
    const filmVideo =
      document.querySelector<HTMLVideoElement>("[data-film-video]")
    const filmPoster = document.querySelector<HTMLElement>("[data-film-poster]")
    const filmChrome = document.querySelector<HTMLElement>("[data-film-chrome]")
    const heroWord = document.querySelector<HTMLElement>("[data-hero-word]")
    const irisSvg = document.querySelector<SVGSVGElement>("[data-iris-svg]")
    const irisArc = document.querySelector<SVGCircleElement>("[data-iris-arc]")
    const irisTicks = document.querySelector<SVGGElement>("[data-iris-ticks]")
    const filmLines = Array.from(
      document.querySelectorAll<HTMLElement>("[data-film-line]")
    )

    if (filmSection && filmStage && filmMedia && !reducedMotion) {
      // The address bar of a phone resizes the window as it hides: recomputing
      // the pinned hero then would make the page jump mid-scroll
      ScrollTrigger.config({ ignoreMobileResize: true })
      // Portrait screens (phones): no lens, a laser line sweeps the film instead
      const portrait = matchMedia("(max-aspect-ratio: 4/5)").matches
      const filmScan = document.querySelector<HTMLElement>("[data-film-scan]")
      if (portrait) filmMedia.style.clipPath = "none"
      filmLines.forEach((line) => {
        // A flex column, so each line keeps its vertical alignment
        line.classList.replace("hidden", "flex")
        gsap.set(line, { autoAlpha: 0 })
      })

      const ats = filmLines.map((l) => Number(l.dataset.at ?? 0))
      const countEl = filmSection.querySelector<HTMLElement>("[data-film-n]")
      const sceneEl =
        filmSection.querySelector<HTMLElement>("[data-film-scene]")
      const barEl = filmSection.querySelector<HTMLElement>("[data-film-bar]")
      const hintEl = filmSection.querySelector<HTMLElement>("[data-film-hint]")
      const openingScene = sceneEl?.textContent ?? ""

      let stageW = filmStage.clientWidth || window.innerWidth
      let stageH = filmStage.clientHeight || window.innerHeight
      let fullR = Math.round(Math.hypot(stageW * 0.5, stageH * 0.54) + 12)
      let lensR = Math.round(Math.min(stageW, stageH) * 0.24)

      const measureStage = () => {
        stageW = filmStage.clientWidth || window.innerWidth
        stageH = filmStage.clientHeight || window.innerHeight
        fullR = Math.round(Math.hypot(stageW * 0.5, stageH * 0.54) + 12)
        lensR = Math.round(Math.min(stageW, stageH) * 0.24)
        if (irisSvg) {
          const box = Math.round(lensR * (240 / 106))
          irisSvg.style.width = `${box}px`
          irisSvg.style.height = `${box}px`
        }
      }
      measureStage()
      window.addEventListener("resize", measureStage, { passive: true })
      cleanups.push(() => window.removeEventListener("resize", measureStage))

      // -1 = Chapter 0 (hero open state); 0 = Chapter 1 (lens); 1 = Chapter 2 (finale)
      let shown = -1
      const showOverlayChapter = (i: number) => {
        if (i === shown) return
        const prev = shown >= 0 ? filmLines[shown] : undefined
        const next = i >= 0 ? filmLines[i] : undefined
        const dir = i > shown ? 1 : -1
        shown = i

        if (prev) {
          const prevWords = prev.querySelectorAll(".film-w")
          const prevExtra = prev.querySelectorAll(".film-extra")
          gsap.killTweensOf([prev, ...prevWords, ...prevExtra])
          gsap.to(prevWords, {
            yPercent: -115 * dir,
            stagger: 0.014,
            duration: 0.32,
            ease: "power3.in",
            onComplete: () => {
              gsap.set(prev, { autoAlpha: 0 })
              prev.setAttribute("aria-hidden", "true")
            },
          })
          if (prevExtra.length) {
            gsap.to(prevExtra, { y: -16 * dir, opacity: 0, duration: 0.24 })
          }
        }

        if (next) {
          const nextWords = next.querySelectorAll(".film-w")
          const nextExtra = next.querySelectorAll(".film-extra")
          gsap.killTweensOf([next, ...nextWords, ...nextExtra])
          gsap.set(next, { autoAlpha: 1 })
          next.removeAttribute("aria-hidden")
          gsap.fromTo(
            nextWords,
            { yPercent: 115 * dir },
            {
              yPercent: 0,
              stagger: 0.03,
              duration: 0.72,
              ease: "expo.out",
              delay: 0.06,
            }
          )
          if (nextExtra.length) {
            gsap.fromTo(
              nextExtra,
              { y: 18 * dir, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                stagger: 0.06,
                duration: 0.6,
                ease: "expo.out",
                delay: 0.14,
              }
            )
          }
        }

        if (countEl) countEl.textContent = String(i + 2).padStart(2, "0")
        const targetScene = next?.dataset.scene ?? openingScene
        if (sceneEl && targetScene) {
          sceneEl.textContent = targetScene
          gsap.fromTo(
            sceneEl,
            { y: 6 * dir, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.35, ease: "expo.out" }
          )
        }
      }

      const easeInOut = (t: number) =>
        t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2
      const clamp01 = (v: number) => Math.max(0, Math.min(1, v))

      // Deferred blob load so LCP photo paints immediately at 0 ms
      let filmTarget = 0
      let filmTime = 0
      let filmReady = false
      let blobUrl = ""
      let videoStarted = false

      const tickFilm = () => {
        if (!filmReady || !filmVideo) return
        filmTime += (filmTarget - filmTime) * 0.22
        if (
          !filmVideo.seeking &&
          Math.abs(filmVideo.currentTime - filmTime) > 0.016
        ) {
          filmVideo.currentTime = filmTime
        }
      }
      gsap.ticker.add(tickFilm)
      cleanups.push(() => gsap.ticker.remove(tickFilm))

      const st = ScrollTrigger.create({
        trigger: filmSection,
        start: "top 64px",
        // The stage holds itself with CSS (position: sticky, .film-track
        // below), so nothing is pinned or inserted by script: the page never
        // jumps when the library arrives mid-scroll, and phones scroll it on
        // their own thread. The film runs while the stage is held
        end: () => `bottom ${64 + filmStage.offsetHeight}px`,
        refreshPriority: 10,
        onUpdate: (self) => {
          const p = self.progress
          if (filmVideo?.duration) filmTarget = p * (filmVideo.duration - 0.05)

          // Phones: the laser line sweeps down over the first third, lifting
          // the veil, while the film slowly pushes in. Transforms only
          let lensMix = 0
          if (portrait) {
            const scan = easeInOut(clamp01(p / 0.34))
            if (filmScan)
              filmScan.style.transform = `translate3d(0, ${(scan * 101).toFixed(2)}%, 0)`
            filmMedia.style.transform = `scale(${(1 + 0.1 * p).toFixed(4)})`
          } else {
            // Continuous iris aperture choreography: full -> lens (0..0.28) -> hold (0.28..0.64) -> full (0.64..0.86)
            const shrinkT = easeInOut(clamp01(p / 0.28))
            const expandT = easeInOut(clamp01((p - 0.64) / 0.22))
            lensMix = shrinkT * (1 - expandT)
            const r = Math.round(fullR - (fullR - lensR) * lensMix)
            const cy = Math.round(48 - 11 * lensMix)
            filmMedia.style.clipPath = `circle(${r}px at 50% ${cy}%)`
            if (irisSvg) irisSvg.style.top = `${cy}%`
          }

          if (!filmReady && filmPoster && !portrait) {
            gsap.set(filmPoster, { scale: 1 + p * 0.08 })
          }

          // Hero top chrome + monumental LASERCOM peel smoothly out as the portal closes
          const heroOut = clamp01(p / 0.2)
          if (filmChrome) {
            filmChrome.style.opacity = String(1 - heroOut)
            filmChrome.style.transform = `translate3d(0, ${-24 * heroOut}px, 0)`
            filmChrome.style.pointerEvents = heroOut > 0.5 ? "none" : "auto"
          }
          if (heroWord) {
            heroWord.style.opacity = String(1 - heroOut)
            heroWord.style.transform = `translate3d(0, ${32 * heroOut}px, 0) scale(${1 + 0.08 * heroOut})`
          }

          // Glowing laser reticle appears precisely when the circular lens locks
          const irisAlpha = clamp01((lensMix - 0.35) / 0.65)
          if (irisSvg) irisSvg.style.opacity = String(irisAlpha)
          if (irisArc) {
            const trace = clamp01((p - 0.14) / 0.48)
            irisArc.style.strokeDashoffset = String(1 - trace)
          }
          if (irisTicks) {
            irisTicks.setAttribute(
              "transform",
              `rotate(${(p * 120).toFixed(1)} 120 120)`
            )
          }

          if (barEl) barEl.style.transform = `scaleX(${p})`
          if (hintEl) hintEl.style.opacity = p > 0.06 ? "0" : "1"

          let nextIdx = -1
          for (let k = ats.length - 1; k >= 0; k--) {
            if (p >= ats[k]) {
              nextIdx = k
              break
            }
          }
          showOverlayChapter(nextIdx)
        },
      })
      cleanups.push(() => st.kill())

      const loadFilmBlob = async () => {
        if (videoStarted || !filmVideo?.dataset.src) return
        const conn = (
          navigator as Navigator & {
            connection?: { saveData?: boolean; effectiveType?: string }
          }
        ).connection
        if (conn?.saveData) return
        videoStarted = true
        try {
          // Portrait screens get the 9:16 cut: a third of the bytes, no wasted pixels
          const portrait = window.matchMedia("(max-aspect-ratio: 4/5)").matches
          // Wide screens with more than 2400 real pixels across (a retina
          // laptop, a large monitor) get the 2560 px cut, on a fast connection
          const large =
            !portrait &&
            innerWidth * devicePixelRatio >= 2400 &&
            !/(^|-)[23]g$/.test(conn?.effectiveType ?? "")
          const src =
            (portrait && filmVideo.dataset.srcPhone) ||
            (large && filmVideo.dataset.srcLarge) ||
            filmVideo.dataset.src
          const blob = await (await fetch(src)).blob()
          blobUrl = URL.createObjectURL(blob)
          filmVideo.src = blobUrl
          await new Promise<void>((ok) =>
            filmVideo.addEventListener("loadeddata", () => ok(), { once: true })
          )
          await filmVideo.play().catch(() => {})
          filmVideo.pause()
          filmTarget = st.progress * (filmVideo.duration - 0.05)
          filmTime = filmTarget
          filmVideo.currentTime = filmTime
          filmReady = true
          filmVideo.classList.remove("opacity-0")
          filmVideo.classList.add("opacity-100")
        } catch {
          /* poster remains intact */
        }
      }

      const onInteract = () => void loadFilmBlob()
      ;(["scroll", "wheel", "pointerdown", "touchstart"] as const).forEach(
        (ev) => {
          window.addEventListener(ev, onInteract, { once: true, passive: true })
          cleanups.push(() => window.removeEventListener(ev, onInteract))
        }
      )
      // The film is several megabytes: it waits for the page to finish loading
      // and settle, unless the visitor moves first
      let idleTimer = 0
      const whenIdle = () => {
        idleTimer = window.setTimeout(() => void loadFilmBlob(), 3000)
      }
      if (document.readyState === "complete") whenIdle()
      else window.addEventListener("load", whenIdle, { once: true })
      cleanups.push(() => {
        window.removeEventListener("load", whenIdle)
        window.clearTimeout(idleTimer)
        if (blobUrl) URL.revokeObjectURL(blobUrl)
      })
    }

    return () => cleanups.forEach((fn) => fn())
  }

  let cleanupHome: (() => void) | undefined
  let visit = 0
  document.addEventListener("astro:page-load", () => {
    cleanupHome?.()
    cleanupHome = undefined
    const current = ++visit
    void motion.then((libs) => {
      if (current === visit) cleanupHome = setupHomeInteractive(libs)
    })
  })
  document.addEventListener("astro:before-swap", () => {
    visit++
    cleanupHome?.()
    cleanupHome = undefined
  })
</script>
<style>
  .film-w-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding: 0.06em 0.04em 0.14em;
    margin: -0.06em 0.14em -0.14em -0.04em;
  }
  .film-w {
    will-change: transform;
  }
  .film-w:not(.block) {
    display: inline-block;
  }
  /* The scroll the hero film plays over, reserved by CSS from the first paint:
     the stage sticks under the 4rem header while the track scrolls past.
     Three screens on wide screens, 2.4 stages on phones. Without JS or with
     reduced motion the hero is a plain screen */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .film-track {
      height: calc(max(100svh - 4rem, 34rem) + 300svh);
    }
    :global(html.js) .film-stage {
      position: sticky;
      top: 4rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-aspect-ratio: 4/5) {
    :global(html.js) .film-track {
      height: calc(max(100svh - 4rem, 34rem) * 3.4);
    }
  }
  /* The beam: a hot core with a red glow, sitting on the veil's top edge */
  .film-scan-line {
    box-shadow:
      0 0 6px 1px var(--laser),
      0 0 28px 6px color-mix(in oklab, var(--laser) 55%, transparent),
      0 -40px 60px 10px color-mix(in oklab, var(--laser) 14%, transparent);
  }
  .film-wheel {
    animation: film-wheel 1.8s ease-in-out infinite;
  }
  @keyframes film-wheel {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.9;
    }
    60% {
      transform: translateY(5px);
      opacity: 0.25;
    }
  }
</style>
