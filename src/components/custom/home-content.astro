---
import { Image, getImage } from "astro:assets"
import filmPoster from "@/assets/film/hero-film.jpg"
import filmPosterPhone from "@/assets/film/hero-film-m.jpg"
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import { LogoMark } from "@/components/custom/logo"
import CloseSection from "@/components/custom/close-section.astro"
import FaqSection from "@/components/custom/faq-section.astro"
import WorkIndex from "@/components/custom/work-index.astro"
import WorkPhoto from "@/components/custom/work-photo.astro"
import OpenStatus from "@/components/custom/open-status.astro"
import GuideCards from "@/components/custom/guide-cards.astro"
import { business, whatsappHref } from "@/lib/business"
import { guideIds } from "@/lib/guides"
import { homeFaqIndices } from "@/lib/pages"
import { photo, services, type ServiceId } from "@/lib/services"
import { cn } from "@/lib/utils"
import { ArrowRight, ArrowUpRight, Star } from "lucide-react"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)
const serviceHref = (id: ServiceId) =>
  lang === "en" ? services[id].en : services[id].es

// Three processes: Cutting, Engraving, Marking — clean visual switch
// Four core materials: Kaizencode full-screen sticky panels, photography-first
const materials: { id: ServiceId; steel: boolean }[] = [
  { id: "madera", steel: false },
  { id: "metacrilato", steel: true },
  { id: "metal", steel: false },
  { id: "piel", steel: true },
]

const clientGroups: {
  anchor: string
  title: string
  text: string
  ids: ServiceId[]
}[] = [
  {
    anchor: "servicios-empresa",
    title: t("home.clients.business.title"),
    text: t("home.clients.business.text"),
    ids: ["industrial", "empresas", "letras"],
  },
  {
    anchor: "servicios-particular",
    title: t("home.clients.people.title"),
    text: t("home.clients.people.text"),
    ids: ["bodas", "joyeria", "personalizado", "decoracion"],
  },
]

const processSteps = [1, 2, 3, 4] as const
const processFacts = [
  t("home.process.fact.1"),
  t("home.process.fact.2"),
  t("home.process.fact.3"),
  t("home.process.fact.4"),
]

const reviews = [
  { name: "Pau Pastor", text: t("home.reviews.1") },
  { name: "Lorena Tabuenca", text: t("home.reviews.2") },
  { name: "Olga Gomez", text: t("home.reviews.3") },
]
const faqs = homeFaqIndices.map((n) => ({
  q: t(`home.faq.${n}.q`),
  a: t(`home.faq.${n}.a`),
}))

// Clean mechanical gear vector drawn by scroll progress
const gear = (() => {
  const teeth = 14
  const [r1, r2, cx, cy] = [128, 156, 170, 170]
  const pts: string[] = []
  for (let i = 0; i < teeth; i++) {
    const a = (i / teeth) * Math.PI * 2
    const step = (Math.PI * 2) / teeth
    const at = (r: number, ang: number) =>
      `${(cx + r * Math.cos(ang)).toFixed(1)} ${(cy + r * Math.sin(ang)).toFixed(1)}`
    pts.push(
      at(r1, a),
      at(r2, a + step * 0.12),
      at(r2, a + step * 0.42),
      at(r1, a + step * 0.54)
    )
  }
  const ring = `M${pts.join("L")}Z`
  const bore = `M${cx + 46} ${cy}A46 46 0 1 1 ${cx + 46} ${cy - 0.01}`
  return `${ring}${bore}`
})()

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
// First frame of the hero film, in the cut each screen will play: the wide one
// and the 9:16 one, so the photo and the video that replaces it line up
const posterWide = await getImage({
  src: filmPoster,
  widths: [840, 1280, 1920],
  format: "webp",
  quality: 62,
})
const posterPhone = await getImage({
  src: filmPosterPhone,
  widths: [420, 640, 828, 1080],
  format: "webp",
  quality: 62,
})
const heroChars = [...business.name.toUpperCase()]
const filmChapter1Words = t("hero.film.2.line").split(" ")
const filmChapter2Words = t("hero.film.3.line").split(" ")
---

<!-- 1. IRIS PORTAL FILM HERO: Dimeunrestaurante circular portal + Cepa scrubbed film + Lasercom monumental display -->
<section
  data-film
  class="film-track steel relative overflow-x-clip border-b border-white/10"
>
  <div
    data-film-stage
    class="film-stage relative h-[calc(100svh-4rem)] min-h-[34rem] overflow-hidden bg-[#0b0a09]"
  >
    <!-- Optical Iris Portal: starts full-bleed (0ms LCP), contracts to circular lens mid-scroll, expands for fiber metal finale -->
    <div
      data-film-media
      class="pointer-events-none absolute inset-0 overflow-hidden will-change-[clip-path]"
      style="clip-path: circle(120% at 50% 48%);"
      aria-hidden="true"
    >
      <div
        data-film-poster
        class="film-poster absolute inset-0 overflow-hidden transition-opacity duration-700"
      >
        <picture>
          <source
            media="(max-aspect-ratio: 4/5)"
            srcset={posterPhone.srcSet.attribute}
            sizes="100vw"
            type="image/webp"
          />
          <img
            src={posterWide.src}
            srcset={posterWide.srcSet.attribute}
            sizes="100vw"
            alt=""
            width={posterWide.attributes.width}
            height={posterWide.attributes.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="size-full object-cover object-center"
          />
        </picture>
      </div>

      <video
        data-film-video
        data-src={`${base}/video/hero-film.mp4?v=2`}
        data-src-phone={`${base}/video/hero-film-m.mp4?v=2`}
        data-src-large={`${base}/video/hero-film-xl.mp4?v=2`}
        muted
        playsinline
        preload="none"
        class="film-video absolute inset-0 size-full object-cover object-center opacity-0 transition-opacity duration-700"
      ></video>

      <!-- Portrait screens: a laser line sweeps down with the scroll and lifts
           a dark veil off the film. The lens below is for wide screens only -->
      <div
        data-film-scan
        class="absolute inset-0 hidden will-change-transform tall:block"
        style="background: oklch(0.11 0.006 60 / 0.5);"
      >
        <span class="film-scan-line absolute inset-x-0 top-0 h-0.5 bg-laser"></span>
      </div>

      <!-- Clean top/bottom editorial edge vignette leaving the center laser glow completely unobstructed -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(180deg, oklch(0.11 0.006 60 / 0.78) 0%, transparent 34%, transparent 50%, oklch(0.11 0.006 60 / 0.92) 100%);"
      ></div>
    </div>

    <!-- Glowing Optical Laser Reticule: fades in around the circular iris on mid-scroll -->
    <svg
      data-iris-svg
      viewBox="0 0 240 240"
      class="pointer-events-none absolute top-[37%] left-1/2 z-10 size-[46vmin] max-w-[26rem] -translate-x-1/2 -translate-y-1/2 opacity-0 tall:hidden"
      aria-hidden="true"
    >
      <circle
        cx="120"
        cy="120"
        r="106"
        fill="none"
        stroke="rgb(255 255 255 / 0.14)"
        stroke-width="1"
      />
      <circle
        data-iris-arc
        cx="120"
        cy="120"
        r="106"
        fill="none"
        stroke="var(--laser)"
        stroke-width="2"
        pathLength="1"
        stroke-dasharray="1"
        stroke-dashoffset="1"
        transform="rotate(-90 120 120)"
        style="filter: drop-shadow(0 0 10px var(--laser));"
      />
      <g data-iris-ticks stroke="rgb(255 255 255 / 0.45)" stroke-width="1.2">
        <line x1="120" y1="4" x2="120" y2="14" />
        <line x1="120" y1="226" x2="120" y2="236" />
        <line x1="4" y1="120" x2="14" y2="120" />
        <line x1="226" y1="120" x2="236" y2="120" />
      </g>
    </svg>

    <!-- Mid-Stage Scrubbed Chapters 1 & 2 (absolute so hidden flex children never push LASERCOM down) -->
    <div class="pointer-events-none absolute inset-0 z-20 px-5 md:px-8 lg:px-12">
      <div
        data-film-line="1"
        data-at="0.30"
        data-scene={t("hero.film.2.scene")}
        aria-hidden="true"
        class="film-line absolute inset-x-5 top-[62%] hidden flex-col items-center text-center tall:top-auto tall:bottom-28 md:inset-x-8 lg:inset-x-12"
      >
        <p class="display mx-auto max-w-4xl text-[clamp(1.4rem,3.8vw,3.35rem)] leading-[1.04] text-white">
          {filmChapter1Words.map((word) => (
            <span class="film-w-mask">
              <span class="film-w">{word}</span>
            </span>
          ))}
        </p>
      </div>

      <div
        data-film-line="2"
        data-at="0.72"
        data-scene={t("hero.film.3.scene")}
        aria-hidden="true"
        class="film-line pointer-events-auto absolute inset-0 hidden flex-col items-center justify-center gap-6 px-5 text-center tall:justify-end tall:pb-28"
      >
        <!-- The film ends on light plywood: a soft shade behind the closing
             line keeps the white text legible. Portrait screens have the veil -->
        <div
          aria-hidden="true"
          class="film-extra pointer-events-none absolute inset-0 -z-10 tall:hidden"
          style="background: radial-gradient(ellipse 50% 42% at 50% 50%, oklch(0.11 0.006 60 / 0.62), transparent 78%);"
        ></div>
        <p class="display mx-auto max-w-4xl text-[clamp(1.75rem,4.6vw,4.15rem)] leading-[1.03] text-white drop-shadow-[0_4px_24px_rgb(0_0_0/0.65)]">
          {filmChapter2Words.map((word) => (
            <span class="film-w-mask">
              <span class="film-w">{word}</span>
            </span>
          ))}
        </p>
        <div class="film-extra flex flex-wrap items-center justify-center gap-3">
          <a
            href={`${href("/contacto/")}#presupuesto`}
            class={buttonVariants({
              size: "lg",
              className: "h-12 rounded-full px-6 text-base",
            })}
          >
            {t("cta.quote")}
            <ArrowRight className="size-4" aria-hidden />
          </a>
          <a
            href={href("/trabajos/")}
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              className:
                "h-12 rounded-full border-white/35 bg-black/35 px-6 text-base text-white backdrop-blur-xs hover:bg-white/10",
            })}
          >
            {t("home.work.all")}
          </a>
        </div>
      </div>
    </div>

    <!-- Foreground Architectural Chrome -->
    <div class="relative z-20 mx-auto flex size-full flex-col justify-between px-5 pt-5 pb-16 sm:pb-6 md:px-8 lg:px-12 lg:pt-7 lg:pb-6">
      <!-- Top Architectural Metadata Row (visible at 0ms, peels cleanly on scroll) -->
      <div
        data-film-chrome
        class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
      >
        <div class="flex flex-col items-start gap-2.5">
          <p class="hero-in readout text-laser-ink" style="--i: 0">
            {t("home.readout")}
          </p>
          <h1 class="display max-w-[19ch] text-[clamp(1.5rem,3.1vw,2.75rem)] leading-[0.98] tracking-tight text-white">
            {t("home.h1.1")} {t("home.h1.2")}{" "}
            <span class="text-laser-ink">{t("home.h1.3")}</span>
          </h1>
          <div
            class="hero-in flex flex-wrap items-center gap-4 pt-1"
            style="--i: 2"
          >
            <span class="sm:-m-2 sm:p-2">
              <a
                href={`${href("/contacto/")}#presupuesto`}
                data-magnetic
                class={buttonVariants({
                  size: "lg",
                  className:
                    "h-11 rounded-full px-6 text-sm font-semibold sm:h-12 sm:text-base",
                })}
              >
                {t("cta.quote")}
                <ArrowRight className="size-4" aria-hidden />
              </a>
            </span>
            <a
              href={whatsappHref(t("wa.default"))}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-white/85 underline-offset-4 transition-colors hover:text-white hover:underline"
            >
              {t("cta.whatsapp.short")}
              <ArrowUpRight className="size-4 text-laser-ink" aria-hidden />
            </a>
          </div>
        </div>

        <aside
          class="hero-in hidden shrink-0 flex-col items-end gap-1 text-right font-mono text-xs tracking-wider text-white/75 uppercase sm:flex"
          style="--i: 1"
        >
          <span>
            {business.locality} · {business.region}
          </span>
          <span>
            {t("home.stat.since")} {business.founded} ·{" "}
            {lang === "es" ? "4,5" : "4.5"} ★ Google
          </span>
          <OpenStatus lang={lang} class="mt-0.5 text-white/60" />
        </aside>
      </div>

      <!-- Bottom Monumental Brand Display + Compact Chapter HUD -->
      <div class="flex flex-col gap-2.5">
        <p
          data-hero-word
          aria-hidden="true"
          class="display pointer-events-none flex w-full justify-between overflow-hidden text-[clamp(2.45rem,12.2vw,11.2rem)] leading-[0.82] tracking-[-0.045em] text-[#f6f1e9] select-none [font-stretch:125%] sm:text-[clamp(3.2rem,13.6vw,11.2rem)]"
        >
          {heroChars.map((c, idx) => (
            <span class="hero-char inline-block" style={`--ci: ${idx}`}>
              {c}
            </span>
          ))}
        </p>

        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-white/15 pt-3 font-mono text-[11px] tracking-wider text-muted-foreground sm:text-xs lg:pr-16">
          <div class="flex items-center gap-3">
            <span class="font-semibold text-foreground tabular-nums">
              <span data-film-n>01</span> / 03
            </span>
            <span class="hidden h-px w-8 overflow-hidden bg-white/20 sm:inline-block">
              <span
                data-film-bar
                class="block h-full w-full origin-left scale-x-0 bg-laser-ink"
              ></span>
            </span>
            <span data-film-scene class="uppercase text-white/80">
              {t("hero.film.1.scene")}
            </span>
          </div>

          <p
            data-film-hint
            class="hidden items-center gap-2 text-xs text-white/75 lg:inline-flex"
            aria-hidden="true"
          >
            <span class="inline-block h-4 w-2.5 rounded-full border border-white/45 p-0.5">
              <span class="film-wheel block h-1 w-full rounded-full bg-laser-ink" />
            </span>
            <span>{t("hero.film.scroll")}</span>
          </p>

          <span class="hidden tabular-nums sm:inline">
            10+ {t("home.stat.materials").toLowerCase()}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- 1b. MANIFESTO: Open space, scroll-lit words & single precision vector cut -->
<section class="grid items-center gap-12 px-5 py-28 md:px-8 lg:min-h-[75svh] lg:grid-cols-12 lg:px-12 lg:py-36">
  <p
    data-burn
    class="display text-[clamp(2rem,4.6vw,4.5rem)] leading-[1.03] lg:col-span-8"
  >
    {t("home.statement")}
  </p>
  <div
    class="relative mx-auto w-full max-w-[18rem] lg:col-span-4"
    aria-hidden="true"
  >
    <svg viewBox="0 0 340 340" class="w-full overflow-visible text-foreground">
      <g
        stroke="currentColor"
        stroke-opacity="0.1"
        stroke-width="1"
        fill="none"
      >
        <circle cx="170" cy="170" r="168" stroke-dasharray="3 6" />
        <line x1="170" y1="0" x2="170" y2="340" />
        <line x1="0" y1="170" x2="340" y2="170" />
      </g>
      <path
        d={gear}
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.14"
        stroke-width="1.5"
      ></path>
      <path
        data-cut
        d={gear}
        fill="none"
        stroke="var(--laser-ink)"
        stroke-width="2.5"
        stroke-linejoin="round"
      ></path>
      <circle
        data-cut-dot
        r="6"
        fill="var(--laser)"
        opacity="0"
        class="drop-shadow-[0_0_8px_var(--laser)]"
      ></circle>
    </svg>
  </div>
</section>
<!-- 2. SELECTED WORK: Photo-dominant split (ProjectIndex architecture) -->
<div class="border-t border-border">
  <WorkIndex
    id="trabajos"
    lang={lang}
    slugs={["barcelo", "lv", "lv2", "maqueta", "placa"]}
    title={t("home.work.title")}
    lead={t("home.work.lead")}
    more={{ label: t("home.work.all"), href: href("/trabajos/") }}
  />
</div>
<!-- 3. REVIEWS: what Google says, at headline size, right after the work -->
<section
  aria-labelledby="reviews-title"
  class="steel px-5 py-20 md:px-8 lg:px-12 lg:py-32"
>
  <h2 id="reviews-title" class="sr-only">
    {t("home.reviews.title")}
  </h2>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex items-end gap-4">
      <span class="display text-[clamp(5rem,13vw,11rem)] leading-[0.8] tabular-nums">
        {lang === "es" ? "4,5" : "4.5"}
      </span>
      <span class="flex flex-col gap-1.5 pb-1">
        <span class="flex gap-0.5" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => (
            <Star
              className={cn(
                "size-6",
                i < 4 ? "fill-laser text-laser" : "fill-laser/50 text-laser"
              )}
            />
          ))}
        </span>
        <span class="readout text-muted-foreground">
          {t("home.reviews.summary")} · {t("home.reviews.count")}
        </span>
      </span>
    </div>
    <a
      href={business.mapsUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 w-fit items-center gap-2 text-laser-ink underline-offset-4 hover:underline"
    >
      {t("home.reviews.link")}
      <ArrowUpRight className="size-4" aria-hidden />
    </a>
  </div>

  <div class="mt-12 grid gap-12 border-t border-white/15 pt-12 lg:grid-cols-12 lg:gap-16">
    <figure class="flex flex-col gap-6 lg:col-span-7">
      <blockquote
        data-lines
        class="text-[clamp(1.5rem,2.7vw,2.5rem)] leading-[1.18] font-semibold tracking-tight text-balance"
      >
        “{reviews[1].text}”
      </blockquote>
      <figcaption class="readout text-muted-foreground">
        {reviews[1].name} · Google
        {t("home.reviews.translated") && ` · ${t("home.reviews.translated")}`}
      </figcaption>
    </figure>
    <ul class="flex flex-col gap-10 lg:col-span-5" data-stagger>
      {[reviews[0], reviews[2]].map(({ name, text }) => (
        <li class="flex flex-col gap-4 border-t border-white/15 pt-6">
          <p class="text-lg leading-relaxed text-foreground/90">“{text}”</p>
          <p class="readout text-muted-foreground">
            {name} · Google
            {t("home.reviews.translated") &&
              ` · ${t("home.reviews.translated")}`}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
<!-- 4. WHO IT'S FOR: Clean hairline directory without visual clutter -->
<section
  id="servicios"
  class="scroll-mt-16 border-t border-border px-5 py-24 md:px-8 lg:px-12 lg:py-36"
>
  <h2
    class="display mb-14 max-w-[16ch] text-[clamp(2.75rem,7vw,6rem)]"
    data-title-chars
  >
    {t("home.clients.title")}
  </h2>
  <div class="grid gap-16 lg:grid-cols-2 lg:gap-12">
    {clientGroups.map((group) => (
      <div id={group.anchor} class="flex scroll-mt-20 flex-col gap-6" data-rows>
        <div class="flex flex-col gap-2">
          <h3 class="text-2xl font-bold tracking-tight md:text-3xl">
            {group.title}
          </h3>
          <p class="max-w-lg text-muted-foreground">{group.text}</p>
        </div>
        <ul class="border-b border-border">
          {group.ids.map((id) => (
            <li data-row class="relative">
              <span
                data-row-line
                class="absolute inset-x-0 top-0 h-px origin-left bg-border"
              />
              <a
                href={serviceHref(id)}
                data-cursor={t("cursor.service")}
                class="group flex items-center justify-between gap-4 py-5 transition-[padding] duration-500 ease-out hover:pl-3"
              >
                <span class="flex min-w-0 flex-col gap-1">
                  <span
                    data-row-cell
                    class="text-xl font-semibold tracking-tight transition-colors group-hover:text-laser-ink md:text-2xl"
                  >
                    {t(`svc.${id}.name`)}
                  </span>
                  <span
                    data-row-cell
                    class="text-sm text-muted-foreground md:text-base"
                  >
                    {t(`svc.${id}.card`)}
                  </span>
                </span>
                <ArrowRight className="size-5 shrink-0 text-laser-ink transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<!-- 5. MATERIALS STACK: Full-screen sticky panels, Kaizencode layout -->
<section id="materiales" class="scroll-mt-16 pt-8">
  <div class="grid gap-6 px-5 pb-14 md:px-8 lg:grid-cols-12 lg:px-12">
    <h2
      data-title-chars
      class="display text-[clamp(2.75rem,7vw,6.25rem)] lg:col-span-7"
    >
      {t("home.materials.title")}
    </h2>
    <p
      data-lines
      class="max-w-lg self-end text-lg text-muted-foreground lg:col-span-5"
    >
      {t("home.materials.lead")}
    </p>
  </div>

  <ol>
    {materials.map(({ id, steel }, i) => {
      const uses = t(`svc.${id}.uses`).split(" · ").slice(0, 4)
      // Real pieces from the workshop, never stock or generated images
      const samples = services[id].photos.slice(0, 3)
      return (
        <li
          data-stack-panel
          class="lg:motion-safe:[@media(min-height:680px)]:sticky lg:motion-safe:[@media(min-height:680px)]:top-16"
        >
          <div
            data-stack-inner
            class={cn(
              "relative flex origin-top lg:min-h-[calc(100svh-4rem)] flex-col justify-between gap-8 overflow-hidden border-t border-border px-5 py-8 md:px-8 md:py-12 lg:px-12 lg:py-14",
              steel ? "steel" : "bg-[#efe6d8]"
            )}
          >
            <div
              data-stack-shade
              aria-hidden="true"
