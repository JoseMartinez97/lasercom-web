<script>
  import { gsap } from "gsap"

  const setupHomeInteractive = () => {
    const cleanups: (() => void)[] = []
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches

    // Three techniques tabs with clean GSAP transition
    const studio = document.querySelector<HTMLElement>(
      "[data-technique-studio]"
    )
    if (studio) {
      const tabs = Array.from(
        studio.querySelectorAll<HTMLButtonElement>("[data-tech-tab]")
      )
      const panels = Array.from(
        studio.querySelectorAll<HTMLElement>("[data-tech-panel]")
      )

      tabs.forEach((tab) => {
        const onClick = () => {
          const id = tab.dataset.techTab
          tabs.forEach((t) =>
            t.setAttribute("aria-selected", String(t === tab))
          )
          panels.forEach((p) => {
            const isMatch = p.dataset.techPanel === id
            p.hidden = !isMatch
            if (isMatch && !reducedMotion) {
              const parts = p.querySelectorAll("[data-tech-part]")
              const img = p.querySelector("img")
              gsap.killTweensOf([p, ...parts, img])
              gsap.fromTo(
                p,
                { opacity: 0.3 },
                { opacity: 1, duration: 0.5, ease: "expo.out" }
              )
              if (img) {
                gsap.fromTo(
                  img,
                  { scale: 1.06 },
                  { scale: 1, duration: 0.85, ease: "expo.out" }
                )
              }
              gsap.fromTo(
                parts,
                { y: 14, opacity: 0 },
                {
                  y: 0,
                  opacity: 1,
                  stagger: 0.06,
                  duration: 0.55,
                  ease: "expo.out",
                }
              )
            }
          })
          window.dispatchEvent(new Event("lasercom:refresh"))
        }
        tab.addEventListener("click", onClick)
        cleanups.push(() => tab.removeEventListener("click", onClick))
      })
    }

    return () => cleanups.forEach((fn) => fn())
  }

  let cleanupHome: (() => void) | undefined
  document.addEventListener("astro:page-load", () => {
    cleanupHome?.()
    cleanupHome = setupHomeInteractive()
  })
  document.addEventListener("astro:before-swap", () => {
    cleanupHome?.()
    cleanupHome = undefined
  })
</script>
