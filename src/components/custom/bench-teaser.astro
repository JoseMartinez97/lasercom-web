---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import { services, type ServiceId } from "@/lib/services"
import { ArrowRight } from "lucide-react"
import { ENGRAVE_ROWS, showcaseMaterials as materials } from "@/lib/showcase"

// #materiales: the second movement of the home's stage. The plaque from the
// hero opens into this scene without a seam and turns to face the reader
// blank; as the visitor scrolls, the beam engraves it row by row, the fresh
// cut glowing and cooling behind it, on the machine's bed: a millimetre
// grid whose gantry lines cross where the beam is. A job sheet beside it
// fills in as it works; the other materials are a quiet line of links.
// The piece itself is drawn by home-content.astro (3D on desktop, CSS
// elsewhere), which also drives the pinned stage and the status here.
// Without JavaScript or with reduced motion it is a plain block
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const page = localizePath(lang, "/prueba-tu-grabado/")
const serviceHref = (id: ServiceId) =>
  lang === "en" ? services[id].en : services[id].es

// Ruler figures every 50 mm (the grid is 1 mm = var(--mm))
const rulerMarks = Array.from({ length: 13 }, (_, i) => i * 50)
// The title rises letter by letter, each word in its own mask
const words = (text: string) => {
  let c = 0
  return text
    .split(" ")
    .map((word) => Array.from(word).map((ch) => [ch, c++] as const))
}
---

<section
  id="materiales"
  data-showcase
  aria-labelledby="materiales-title"
  class="steel showcase-track relative scroll-mt-16"
>
  <div class="showcase-stage relative flex flex-col overflow-hidden px-5 py-16 md:px-8 lg:px-14">
    <!-- The machine's bed: a millimetre grid with rulers on two edges, and
         the gantry's two lines crossing where the beam is -->
    <div aria-hidden="true" class="bed pointer-events-none absolute inset-0">
      <div class="bed-ruler bed-ruler-x">
        {rulerMarks.map((mm) => (
          <span style={`left: calc(${mm} * var(--mm))`}>{mm}</span>
        ))}
      </div>
      <div class="bed-ruler bed-ruler-y">
        {rulerMarks.map((mm) => (
          <span style={`top: calc(${mm} * var(--mm))`}>{mm}</span>
        ))}
      </div>
      <span data-gantry-x class="gantry gantry-x"></span>
      <span data-gantry-y class="gantry gantry-y"></span>
    </div>

    <div class="relative z-30 flex items-baseline justify-between gap-4">
      <p class="readout text-laser-ink">{t("home.engrave.readout")}</p>
      <p
        data-engrave-xy
        data-no-scramble
        aria-hidden="true"
        class="showcase-only readout gap-3 text-white/45 tabular-nums"
      >
        <span>
          X <span data-x>000.0</span>
        </span>
        <span>
          Y <span data-y>000.0</span>
        </span>
      </p>
    </div>
    <div
      aria-hidden="true"
      class="showcase-only relative z-30 mt-3 h-px bg-white/12"
    >
      <span
        data-engrave-progress
        class="absolute inset-0 origin-left scale-x-0 bg-[oklch(0.85_0.12_55)] shadow-[0_0_10px_1px_var(--laser)]"
      ></span>
    </div>

    <div class="showcase-body relative z-30 flex flex-1 flex-col justify-between gap-8 pt-8 lg:max-w-[34rem] lg:justify-center lg:gap-12 lg:pt-0">
      <h2
        id="materiales-title"
        data-showcase-title
        class="display showcase-name text-[clamp(2.75rem,5.2vw,5.75rem)] leading-[0.92] text-white"
      >
        <span class="sr-only">{t("home.engrave.title")}</span>
        <span aria-hidden="true">
          {words(t("home.engrave.title")).map((word) => (
            <>
              <span class="showcase-word">
                {word.map(([ch, c]) => (
                  <span class="showcase-char" style={`--c: ${c}`}>
                    {ch}
                  </span>
                ))}
              </span>{" "}
            </>
          ))}
        </span>
      </h2>

      <div class="showcase-copy flex flex-col items-stretch gap-8">
        <!-- The job sheet: what is on the bed, filled in as the beam works -->
        <dl
          data-engrave-sheet
          class="job-sheet grid font-mono text-[0.8125rem] tracking-wide uppercase"
        >
          <div class="job-row job-wide">
            <dt>{t("home.engrave.sheet.piece")}</dt>
            <dd>{t("home.engrave.sheet.pieceValue")}</dd>
          </div>
          <div class="job-row">
            <dt>{t("home.engrave.sheet.material")}</dt>
            <dd>{t("bench.m.acero.name")}</dd>
          </div>
          <div class="job-row job-wide">
            <dt>{t("home.engrave.sheet.laser")}</dt>
            <dd>{t("home.engrave.sheet.laserValue")}</dd>
          </div>
          <div class="job-row">
            <dt>{t("home.engrave.sheet.passes")}</dt>
            <dd class="tabular-nums">
              <span data-engrave-passes>{ENGRAVE_ROWS}</span>&thinsp;/&thinsp;
              {ENGRAVE_ROWS}
            </dd>
          </div>
          <div class="job-row">
            <dt>{t("home.engrave.sheet.status")}</dt>
            <dd
              data-engrave-status
              data-state="done"
              data-ready={t("bench.status.ready")}
              data-burn={t("bench.status.burn")}
              data-done={t("bench.status.done")}
              class="flex items-center gap-2"
            >
              <span class="engrave-led inline-block size-1.5 rounded-full"></span>
              <span data-engrave-label>{t("bench.status.done")}</span>
            </dd>
          </div>
        </dl>

        <div data-engrave-after class="flex flex-col items-start gap-6">
          <a
            href={`${page}?m=acero`}
            class={buttonVariants({
              size: "lg",
              className:
                "h-11 rounded-full px-5 text-[0.9375rem] sm:h-12 sm:px-6 sm:text-base",
            })}
          >
            {t("bench.teaser.cta")}
            <ArrowRight className="size-4" aria-hidden />
          </a>
          <div class="showcase-materials text-sm leading-relaxed text-white/50">
            <p class="readout mb-1.5 text-white/40">
              {t("home.stat.materials")}
            </p>
            <ul class="flex flex-wrap">
              {materials.map((m) => (
                <li>
                  <a
                    href={serviceHref(m.service)}
                    class="transition-colors hover:text-white"
                  >
                    {t(`bench.m.${m.id}.name`)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-only {
    display: none;
  }
  /* The bed: graphite, a 10 mm grid with a stronger line every 50 mm,
     lit a little toward the piece */
  .bed {
    --mm: 3.2px;
    background:
      linear-gradient(rgb(255 255 255 / 0.055) 1px, transparent 1px) 0 0 / 100%
        calc(50 * var(--mm)),
      linear-gradient(90deg, rgb(255 255 255 / 0.055) 1px, transparent 1px) 0
        0 / calc(50 * var(--mm)) 100%,
      linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 100%
        calc(10 * var(--mm)),
      linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px) 0
        0 / calc(10 * var(--mm)) 100%,
      radial-gradient(
        60% 75% at 70% 50%,
        #23272e 0%,
        #15171b 60%,
        #0c0d10 100%
      );
  }
  /* Rulers along the bottom and the left edge: a tick every 10 mm, a
     longer one with its figure every 50 */
  .bed-ruler {
    position: absolute;
    color: rgb(255 255 255 / 0.32);
    font:
      500 9px/1 "JetBrains Mono Variable",
      monospace;
    letter-spacing: 0.04em;
  }
  .bed-ruler-x {
    left: 0;
    right: 0;
    bottom: 0;
    height: 14px;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.3) 1px, transparent 1px) 0
        100% / calc(50 * var(--mm)) 10px repeat-x,
      linear-gradient(90deg, rgb(255 255 255 / 0.18) 1px, transparent 1px) 0
        100% / calc(10 * var(--mm)) 5px repeat-x;
  }
  .bed-ruler-x span {
    position: absolute;
    bottom: 3px;
    padding-left: 4px;
  }
  .bed-ruler-y {
    top: 0;
    bottom: 0;
    left: 0;
    width: 14px;
    background:
      linear-gradient(rgb(255 255 255 / 0.3) 1px, transparent 1px) 0 0 / 10px
        calc(50 * var(--mm)) repeat-y,
      linear-gradient(rgb(255 255 255 / 0.18) 1px, transparent 1px) 0 0 / 5px
        calc(10 * var(--mm)) repeat-y;
  }
  .bed-ruler-y span {
    position: absolute;
    left: 3px;
    padding-top: 4px;
    writing-mode: vertical-rl;
    rotate: 180deg;
    translate: 0 -100%;
  }
  .bed-ruler-y span:first-child {
    display: none;
  }
  /* The gantry: one line across, one down, crossing at the beam. The
     script moves them and fades them in while it works */
  .gantry {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    background: color-mix(in oklab, var(--laser) 55%, transparent);
    will-change: transform, opacity;
  }
  .gantry-x {
    width: 1px;
    height: 100%;
    box-shadow: 0 0 6px color-mix(in oklab, var(--laser) 35%, transparent);
  }
  .gantry-y {
    width: 100%;
    height: 1px;
    box-shadow: 0 0 6px color-mix(in oklab, var(--laser) 35%, transparent);
  }
  .job-sheet {
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .job-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .job-row dt {
    color: rgb(255 255 255 / 0.42);
  }
  .job-row dd {
    color: rgb(255 255 255 / 0.92);
  }
  .showcase-materials li:not(:last-child)::after {
    content: "·";
    margin-inline: 0.5em;
    color: rgb(255 255 255 / 0.3);
  }
  .engrave-led {
    background: rgb(255 255 255 / 0.4);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  [data-state="burn"] .engrave-led {
    background: var(--laser);
    box-shadow: 0 0 8px 1px var(--laser);
  }
  [data-state="done"] .engrave-led {
    background: oklch(0.8 0.15 150);
  }
  .showcase-word {
    display: inline-block;
    /* Room for accents and descenders inside the mask (Dialed's unmask) */
    padding: 0.14em 0.02em 0.2em;
    margin: -0.14em -0.02em -0.2em;
    overflow: hidden;
    vertical-align: top;
  }
  .showcase-char {
    display: inline-block;
  }

  /* The stage: with JavaScript and motion the section is a layer of the
     home's pinned stage (home-content.astro), opened over the hero */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .showcase-track {
      position: absolute;
      inset: 0;
      z-index: 10;
      /* Until the script runs, the scene stays shut behind the hero */
      clip-path: inset(50%);
    }
    :global(html.js) .showcase-stage {
      height: 100%;
      padding-block: 1.5rem;
    }
    :global(html.js) .showcase-only {
      display: flex;
    }
    /* The script lifts the title through its masks and fades the copy in
       from the scroll position (no transitions: the scroll is the clock);
       the button and the materials once the piece is engraved */
    :global(html.js) .showcase-char {
      transform: translateY(115%);
      will-change: transform;
    }
    :global(html.js) [data-engrave-sheet],
    :global(html.js) [data-engrave-after] {
      opacity: 0;
    }
    /* Phones: clear of the fixed action bar (action-bar.astro, below md) */
    @media (max-width: 767px) {
      .bed-ruler-y {
        display: none;
      }
      :global(html.js) .showcase-stage {
        padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
      }
    }
    /* Phones and tablets: title on top, the piece in the middle, copy below */
    @media (max-width: 1023px) {
      :global(html.js) .showcase-body {
        padding-top: 1.25rem;
      }
      :global(html.js) .showcase-name {
        font-size: clamp(2.5rem, 11vw, 4.5rem);
      }
      /* The sheet in one row: material, passes, status */
      :global(html.js) .job-sheet {
        grid-template-columns: 1.4fr 0.9fr 1fr;
        font-size: 0.6875rem;
      }
      :global(html.js) .job-wide {
        display: none;
      }
      :global(html.js) .job-row {
        grid-template-columns: 1fr;
        gap: 0.3rem;
        padding-block: 0.6rem;
      }
      :global(html.js) .showcase-copy,
      :global(html.js) [data-engrave-after] {
        gap: 0.875rem;
      }
      :global(html.js) .showcase-materials {
        display: none;
      }
    }
  }
</style>
