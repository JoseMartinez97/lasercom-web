---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { work, type WorkSlug } from "@/lib/work"
import { ArrowRight } from "lucide-react"

interface Props {
  lang: Lang
  slugs: WorkSlug[]
  title: string
  lead?: string
  more?: { label: string; href: string }
  id?: string
}
const { lang, slugs, title, lead, more, id } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)
const items = slugs.map((slug) => work.find((w) => w.slug === slug)!)
---

<!-- Selected workshop jobs, styled after Kaizencode's ProjectIndex: a large
     sticky photo beside clean hairline rows -->
<section
  id={id}
  data-work
  class="scroll-mt-16 px-5 py-24 md:px-8 lg:px-12 lg:py-36"
>
  <div class="mb-12 grid gap-6 lg:mb-16 lg:grid-cols-12">
    <h2
      data-title-chars
      class="display text-[clamp(2.5rem,6.5vw,5.75rem)] lg:col-span-7"
    >
      {title}
    </h2>
    {lead && (
      <p
        data-lines
        class="max-w-lg self-end text-lg text-muted-foreground lg:col-span-5"
      >
        {lead}
      </p>
    )}
  </div>

  <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
    <!-- Large sticky visual stage on desktop (7 columns, clean uncropped feel) -->
    <div class="hidden lg:sticky lg:top-24 lg:col-span-7 lg:block">
      <div class="relative aspect-[16/11] w-full overflow-hidden rounded-2xl border border-border/75 bg-[#f7f2e8]">
        {items.map((item, i) => (
          <WorkPhoto
            lang={lang}
            name={item.photos[0]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            data-work-shot={item.slug}
            data-active={i === 0 ? "" : undefined}
            class="work-shot absolute inset-0 size-full"
          />
        ))}
      </div>
    </div>

    <!-- Clean numbered rows on the right (5 columns) -->
    <div class="flex flex-col lg:col-span-5">
      <ol data-work-list data-rows class="border-b border-border">
        {items.map((item, i) => (
          <li data-row class="relative transition-opacity duration-300">
            <span
              data-row-line
              class="absolute inset-x-0 top-0 h-px origin-left bg-border"
            />
            <div data-work-row={item.slug} class="grid gap-4 py-5 lg:py-6">
              <a
                href={`${href("/trabajos/")}#${item.slug}`}
                data-cursor={t("home.work.gallery")}
                class="group flex items-start gap-4"
              >
                <span
                  data-row-cell
                  class="mt-1.5 font-mono text-sm text-muted-foreground tabular-nums"
                >
                  {String(i + 1).padStart(3, "0")}
                </span>
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3
                      data-row-cell
                      class="text-2xl leading-tight font-bold tracking-tight transition-[color,translate] duration-500 ease-out group-hover:translate-x-2 group-hover:text-laser-ink md:text-3xl"
                    >
                      {t(`work.${item.slug}.name`)}
                    </h3>
                    <ArrowRight
                      className="size-4 shrink-0 text-laser-ink opacity-70 transition-transform duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                      aria-hidden
                    />
                  </div>
                  <p
                    data-row-cell
                    class="line-clamp-2 text-sm text-muted-foreground md:text-base"
                  >
                    {t(`work.${item.slug}.text`)}
                  </p>
                </div>
              </a>

              <a
                href={`${href("/trabajos/")}#${item.slug}`}
                class="relative block aspect-[16/10] overflow-hidden rounded-xl border border-border/75 bg-[#f7f2e8] lg:hidden"
              >
                <WorkPhoto
                  lang={lang}
                  name={item.photos[0]}
                  sizes="100vw"
                  class="absolute inset-0 size-full"
                />
              </a>
            </div>
          </li>
        ))}
      </ol>

      {more && (
        <a
          href={more.href}
          class="group mt-8 inline-flex min-h-11 w-fit items-center gap-3 text-lg font-semibold tracking-tight hover:text-laser-ink"
        >
          {more.label}
          <ArrowRight
            className="size-5 text-laser-ink transition-transform group-hover:translate-x-1"
            aria-hidden
          />
        </a>
      )}
    </div>
  </div>
</section>
