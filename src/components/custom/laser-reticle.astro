---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg
  viewBox="0 0 96 96"
  aria-hidden="true"
  class={cn("laser-reticle shrink-0", className)}
>
  <circle
    cx="48"
    cy="48"
    r="15"
    fill="var(--laser)"
    class="reticle-halo"
  ></circle>
  <circle
    cx="48"
    cy="48"
    r="37"
    fill="none"
    stroke="var(--foreground)"
    stroke-opacity="0.32"
    stroke-width="1.4"
    stroke-dasharray="4 10.5"
    stroke-linecap="round"
    class="reticle-outer"
  ></circle>
  <circle
    cx="48"
    cy="48"
    r="20"
    fill="none"
    stroke="var(--laser)"
    stroke-opacity="0.72"
    stroke-width="1.8"
    stroke-dasharray="14 17.4"
    stroke-linecap="round"
    class="reticle-inner"
  ></circle>
  <g class="reticle-core">
    <circle cx="48" cy="48" r="4.5" fill="var(--laser)"></circle>
    <circle cx="48" cy="48" r="1.75" fill="var(--beam-spark)"></circle>
  </g>
</svg>

<style>
  .reticle-outer,
  .reticle-inner,
  .reticle-halo,
  .reticle-core {
    transform-origin: 48px 48px;
  }
  .reticle-halo {
    opacity: 0.22;
  }
  @media (prefers-reduced-motion: no-preference) {
    .reticle-outer {
      animation: reticle-spin 3.5s linear infinite;
    }
    .reticle-inner {
      animation: reticle-counter 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
    .reticle-halo {
      animation: reticle-halo 3.5s ease-in-out infinite;
    }
    .reticle-core {
      animation: reticle-core 3.5s ease-in-out infinite;
    }
  }
  @keyframes reticle-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes reticle-counter {
    0% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-90deg);
    }
    100% {
      transform: rotate(-180deg);
    }
  }
  @keyframes reticle-halo {
    0%,
    100% {
      opacity: 0.14;
      transform: scale(0.84);
    }
    50% {
      opacity: 0.34;
      transform: scale(1.08);
    }
  }
  @keyframes reticle-core {
    0%,
    100% {
      transform: scale(0.9);
    }
    50% {
      transform: scale(1.14);
    }
  }
</style>
