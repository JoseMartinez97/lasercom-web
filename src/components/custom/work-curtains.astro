---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { services } from "@/lib/services"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"

// Movement 3: the real pieces, each opening like a cut in the sheet. A
// rounded aperture widens with the scroll while the photo settles from
// 1.12 to 1; a typographic pause sits between them. Without motion the
// frames are simply open
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)

const scenes: {
  photo: string
  name: string
  type: string
  text: string
  link: string
}[] = [
  {
    photo: "corte_grabado_laser_decorar_2",
    name: t("work.barcelo.name"),
    type: t("work.barcelo.type"),
    text: t("work.barcelo.text"),
    link: `${href("/trabajos/")}#barcelo`,
  },
  {
    photo: "grabado_laser_marcas_material",
    name: t("pieces.flask.name"),
    type: t("pieces.flask.type"),
    text: t("pieces.flask.text"),
    link: lang === "en" ? services.metal.en : services.metal.es,
  },
  {
    photo: "abanico_exclusivo_louis_vuitton_4",
    name: t("work.lv.name"),
    type: t("work.lv.type"),
    text: t("work.lv.text"),
    link: `${href("/trabajos/")}#lv`,
  },
  {
    photo: "cortar_grabar_piel_laser_2-1",
    name: t("work.piel.name"),
    type: t("work.piel.type"),
    text: t("work.piel.text"),
    link: `${href("/trabajos/")}#piel`,
  },
  {
    photo: "maqueta_escala_metacrilato_2",
    name: t("work.maqueta.name"),
    type: t("work.maqueta.type"),
    text: t("work.maqueta.text"),
    link: `${href("/trabajos/")}#maqueta`,
  },
]
const total = String(scenes.length).padStart(2, "0")
---

<section
  id="trabajos"
  data-curtains
  aria-labelledby="pieces-title"
  class="scroll-mt-16 px-5 pt-24 pb-10 md:px-8 lg:px-12 lg:pt-36"
>
  <div class="mb-16 grid gap-6 lg:mb-24 lg:grid-cols-12 lg:items-end">
    <div class="flex flex-col gap-4 lg:col-span-7">
      <p class="readout text-laser-ink">{t("pieces.readout")}</p>
      <h2
        id="pieces-title"
        data-title-chars
        class="display text-[clamp(2.75rem,7vw,6.25rem)]"
      >
        {t("home.work.title")}
      </h2>
    </div>
    <div class="flex flex-col gap-4 lg:col-span-5">
      <p data-lines class="max-w-lg text-lg text-muted-foreground">
        {t("home.work.lead")}
      </p>
      <a
        href={href("/trabajos/")}
        class="group inline-flex min-h-11 w-fit items-center gap-2 font-semibold hover:text-laser-ink"
      >
        {t("home.work.all")}
        <ArrowRight className="size-4 text-laser-ink transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <ol class="flex flex-col gap-20 lg:gap-32">
    {scenes.map((scene, i) => (
      <>
        {i === 2 && (
          <li aria-hidden="true" class="py-6 lg:py-16">
            <p
              data-burn
              class="display mx-auto max-w-[18ch] text-center text-[clamp(2rem,5.4vw,5rem)] leading-[1.02]"
            >
              {t("pieces.pause")}
            </p>
          </li>
        )}
        <li
          data-curtain={i % 2 === 0 ? "x" : "y"}
          class="grid items-end gap-6 lg:grid-cols-12 lg:gap-12"
        >
          <a
            href={scene.link}
            data-curtain-frame
            data-cursor={t("pieces.see")}
            class={cn(
              "relative block aspect-[4/5] overflow-hidden sm:aspect-[4/3] lg:aspect-auto lg:h-[min(78svh,52rem)] lg:min-h-[26rem] rounded-[22px] bg-secondary lg:col-span-8",
              i % 2 === 1 && "lg:order-2 lg:col-start-5"
            )}
            aria-label={`${scene.name} · ${t("pieces.see")}`}
          >
            <WorkPhoto
              lang={lang}
              name={scene.photo}
              data-curtain-img
              sizes="(min-width: 1024px) 66vw, 100vw"
              class="absolute inset-0 size-full will-change-transform"
            />
          </a>
          <div
            class={cn(
              "flex flex-col gap-4 lg:col-span-4 lg:pb-4",
              i % 2 === 1 && "lg:order-1 lg:col-start-1 lg:row-start-1"
            )}
          >
            <p class="readout flex items-center gap-3 text-muted-foreground">
              <span class="text-laser-ink tabular-nums">
                {String(i + 1).padStart(2, "0")} / {total}
              </span>
              <span>{scene.type}</span>
            </p>
            <h3 class="display text-[clamp(1.75rem,3vw,2.75rem)] leading-[1]">
              {scene.name}
            </h3>
            <p
              data-lines
              class="max-w-md text-base text-muted-foreground md:text-lg"
            >
              {scene.text}
            </p>
            <a
              href={scene.link}
              class="group inline-flex min-h-11 w-fit items-center gap-2 border-b border-current pb-1 text-sm font-semibold hover:text-laser-ink"
            >
              {t("pieces.see")}
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
        </li>
      </>
    ))}
  </ol>
</section>

<script>
  // GSAP arrives with the rest of the motion (layouts/main.astro); the
  // curtains wait for it and never hide a frame before it is there
  let cleanupCurtains: (() => void) | undefined

  const setup = async () => {
    const root = document.querySelector<HTMLElement>("[data-curtains]")
    if (!root || matchMedia("(prefers-reduced-motion: reduce)").matches) return
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ])
    gsap.registerPlugin(ScrollTrigger)
    const narrow = matchMedia("(max-width: 1023px)").matches
    const ctx = gsap.context(() => {
      root.querySelectorAll<HTMLElement>("[data-curtain]").forEach((scene) => {
        const frame = scene.querySelector<HTMLElement>("[data-curtain-frame]")
        const img = scene.querySelector<HTMLElement>("[data-curtain-img]")
        if (!frame) return
        const across = scene.dataset.curtain === "x" && !narrow
        const closed = across
          ? "inset(0% 50% 0% 50% round 22px)"
          : "inset(50% 0% 50% 0% round 22px)"
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: frame,
            start: "top 95%",
            end: "top 30%",
            scrub: 0.6,
          },
        })
        tl.fromTo(
          frame,
          { clipPath: closed },
          { clipPath: "inset(0% 0% 0% 0% round 22px)", ease: "power2.inOut" },
          0
        )
        if (img)
          tl.fromTo(img, { scale: 1.12 }, { scale: 1, ease: "power2.out" }, 0)
      })
    }, root)
    cleanupCurtains = () => ctx.revert()
  }

  const start = () => {
    cleanupCurtains?.()
    cleanupCurtains = undefined
    // After the first paint and the visitor's first move, like the hero film
    const go = () => void setup()
    if (document.readyState === "complete") setTimeout(go, 300)
    else addEventListener("load", () => setTimeout(go, 300), { once: true })
  }
  document.addEventListener("astro:page-load", start)
  document.addEventListener("astro:before-swap", () => {
    cleanupCurtains?.()
    cleanupCurtains = undefined
  })
</script>
