---
import { FaqAccordion } from "@/components/custom/faq-accordion"

interface Props {
  title: string
  faqs: { q: string; a: string }[]
}
const { title, faqs } = Astro.props
---

<!-- Title held on the left from lg, questions as hairline rows on the right.
     Answers are always in the HTML (forceMount), so they stay indexable -->
<section class="grid gap-10 px-5 py-24 md:px-8 lg:grid-cols-12 lg:py-32">
  <h2
    class="display text-[clamp(2.5rem,6vw,5rem)] lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
    data-title-chars
  >
    {title}
  </h2>
  <div class="lg:col-span-7">
    <FaqAccordion client:visible faqs={faqs} />
  </div>
</section>
