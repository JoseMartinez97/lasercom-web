---
import { FaqAccordion } from "@/components/custom/faq-accordion"

interface Props {
  title: string
  faqs: { q: string; a: string }[]
}
const { title, faqs } = Astro.props
---

<!-- Answers are always in the HTML (forceMount), so they stay indexable -->
<section class="border-t border-border px-5 py-16 md:px-8 md:py-24">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-12">
    <h2 class="display text-[clamp(1.9rem,4vw,3.25rem)] text-foreground lg:sticky lg:top-24 lg:col-span-5 lg:self-start">
      {title}
    </h2>
    <div class="lg:col-span-7">
      <FaqAccordion client:visible faqs={faqs} />
    </div>
  </div>
</section>
