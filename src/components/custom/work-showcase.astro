---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { services } from "@/lib/services"
import { ArrowRight, ArrowUpRight } from "lucide-react"

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)

const scenes: {
  id: string
  photo: string
  name: string
  type: string
  text: string
  link: string
}[] = [
  {
    id: "lv",
    photo: "abanico_exclusivo_louis_vuitton_4",
    name: t("work.lv.name"),
    type: t("work.lv.type"),
    text: t("work.lv.text"),
    link: `${href("/trabajos/")}#lv`,
  },
  {
    id: "barcelo",
    photo: "corte_grabado_laser_decorar_2",
    name: t("work.barcelo.name"),
    type: t("work.barcelo.type"),
    text: t("work.barcelo.text"),
    link: `${href("/trabajos/")}#barcelo`,
  },
  {
    id: "flask",
    photo: "grabado_laser_marcas_material",
    name: t("pieces.flask.name"),
    type: t("pieces.flask.type"),
    text: t("pieces.flask.text"),
    link: lang === "en" ? services.metal.en : services.metal.es,
  },
  {
    id: "piel",
    photo: "cortar_grabar_piel_laser_2-1",
    name: t("work.piel.name"),
    type: t("work.piel.type"),
    text: t("work.piel.text"),
    link: `${href("/trabajos/")}#piel`,
  },
  {
    id: "maqueta",
    photo: "maqueta_escala_metacrilato_2",
    name: t("work.maqueta.name"),
    type: t("work.maqueta.type"),
    text: t("work.maqueta.text"),
    link: `${href("/trabajos/")}#maqueta`,
  },
  {
    id: "placa",
    photo: "grabado_laser_placa_hospital",
    name: t("work.placa.name"),
    type: t("work.placa.type"),
    text: t("work.placa.text"),
    link: `${href("/trabajos/")}#placa`,
  },
]
---

<section
  id="trabajos"
  data-cinema-reel
  aria-labelledby="pieces-title"
  class="obsidian-grid relative scroll-mt-16 overflow-hidden bg-background"
>
  <div
    data-reel-stage
    class="flex flex-col justify-between py-20 lg:h-[calc(100svh-4rem)] lg:py-10"
  >
    <!-- Header row -->
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-5 md:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-12">
      <div class="flex flex-col gap-2">
        <h2
          id="pieces-title"
          data-title-chars
          class="display text-[clamp(2rem,4.4vw,3.75rem)] leading-[0.98] text-foreground"
        >
          {t("home.work.title")}
        </h2>
      </div>

      <div class="flex items-center justify-between gap-6 lg:justify-end">
        <span
          data-reel-counter
          aria-hidden="true"
          class="readout hidden tabular-nums text-muted-foreground lg:inline"
        >
          01 / 0{scenes.length}
        </span>
        <a
          href={href("/trabajos/")}
          class="roll-link group inline-flex min-h-11 w-fit items-center gap-2 pb-1 text-sm font-semibold text-foreground"
        >
          <span class="roll-link-mask">
            <span>{t("home.work.all")}</span>
            <span aria-hidden="true">{t("home.work.all")}</span>
          </span>
          <ArrowRight
            className="size-4 text-laser-ink transition-transform group-hover:translate-x-1"
            aria-hidden
          />
        </a>
      </div>
    </div>

    <!-- Horizontal cinema filmstrip (GSAP ScrollTrigger pinned on desktop, snap rail on mobile) -->
    <div class="mt-8 w-full overflow-hidden lg:mt-6">
      <ul
        data-reel-track
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 [scrollbar-width:none] lg:w-max lg:snap-none lg:gap-8 lg:overflow-visible lg:px-12 lg:pb-0 [&::-webkit-scrollbar]:hidden"
      >
        {scenes.map((scene, i) => (
          <li
            data-reel-card
            class="w-[84vw] max-w-md shrink-0 snap-center will-change-transform lg:w-[44vw] lg:max-w-[600px]"
          >
            <a
              href={scene.link}
              data-cursor={t("pieces.see")}
              class="group flex h-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-card/90 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.65)] transition-colors duration-300 hover:border-laser/45"
            >
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-secondary">
                <WorkPhoto
                  lang={lang}
                  name={scene.photo}
                  sizes="(min-width: 1024px) 44vw, 84vw"
                  class="size-full transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <span class="readout absolute top-4 left-4 rounded-full border border-white/15 bg-background/80 px-3 py-1 text-foreground backdrop-blur-md">
                  0{i + 1} / 0{scenes.length}
                </span>
              </div>

              <div class="flex flex-1 items-end justify-between gap-4 p-5 lg:p-6">
                <div class="flex flex-col gap-1.5">
                  <span class="readout text-laser-ink">{scene.type}</span>
                  <h3 class="display text-xl text-foreground transition-colors group-hover:text-laser-ink lg:text-2xl">
                    {scene.name}
                  </h3>
                  <p class="line-clamp-2 max-w-md text-xs leading-relaxed text-muted-foreground lg:text-sm">
                    {scene.text}
                  </p>
                </div>
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/[0.04] text-muted-foreground transition-all duration-300 group-hover:border-laser/60 group-hover:bg-laser/15 group-hover:text-laser-ink">
                  <ArrowUpRight className="size-4" aria-hidden />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom glowing laser progress rail (desktop pinned reel) -->
    <div class="mx-auto hidden w-full max-w-7xl px-12 lg:block">
      <div class="relative h-px w-full bg-white/12">
        <span
          data-reel-progress
          class="absolute inset-0 origin-left scale-x-0 bg-laser shadow-[0_0_12px_1px_var(--laser)]"
        ></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { loadScrollKit, type ScrollKit } from "@/lib/after-load"

  let stopReel: (() => void) | undefined
  let visit = 0

  const setupCinemaReel = ({ gsap }: ScrollKit) => {
    stopReel?.()
    stopReel = undefined

    const section = document.querySelector<HTMLElement>("[data-cinema-reel]")
    const stage = section?.querySelector<HTMLElement>("[data-reel-stage]")
    const track = section?.querySelector<HTMLElement>("[data-reel-track]")
    const progressEl = section?.querySelector<HTMLElement>(
      "[data-reel-progress]"
    )
    const counterEl = section?.querySelector<HTMLElement>("[data-reel-counter]")
    if (!section || !stage || !track) return

    const cards = gsap.utils.toArray<HTMLElement>("[data-reel-card]", track)
    const total = cards.length

    const mm = gsap.matchMedia()
    mm.add(
      {
        reduceMotion: "(prefers-reduced-motion: reduce)",
        isDesktop: "(min-width: 1024px)",
      },
      (context) => {
        const { reduceMotion, isDesktop } = context.conditions ?? {}
        if (reduceMotion || !isDesktop) return

        const getDistance = () =>
          Math.max(0, track.scrollWidth - stage.clientWidth)

        // Smooth velocity-driven 3D skew that settles back to 0° on stop
        const skewTo = gsap.quickTo(cards, "skewX", {
          duration: 0.45,
          ease: "power3.out",
        })
        let resetTimer = 0

        // Top-level horizontal scroll animation with ease: "none" (per gsap-scrolltrigger)
        gsap.to(track, {
          x: () => -getDistance(),
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top 64px",
            end: () => `+=${Math.max(900, getDistance())}`,
            pin: true,
            pinSpacing: true,
            scrub: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              if (progressEl) {
                progressEl.style.transform = `scaleX(${self.progress.toFixed(4)})`
              }
              if (counterEl && total > 0) {
                const idx = Math.min(
                  total,
                  Math.max(1, Math.round(self.progress * (total - 1)) + 1)
                )
                counterEl.textContent = `0${idx} / 0${total}`
              }
              const clampedSkew = gsap.utils.clamp(
                -5.5,
                5.5,
                self.getVelocity() / -420
              )
              skewTo(clampedSkew)
              window.clearTimeout(resetTimer)
              resetTimer = window.setTimeout(() => skewTo(0), 120)
            },
          },
        })

        return () => {
          window.clearTimeout(resetTimer)
        }
      }
    )

    return () => {
      mm.revert()
    }
  }

  document.addEventListener("astro:page-load", () => {
    const current = ++visit
    void loadScrollKit().then((kit) => {
      // The visitor may have moved on while GSAP loaded
      if (current === visit) stopReel = setupCinemaReel(kit)
    })
  })
  document.addEventListener("astro:before-swap", () => {
    visit++
    stopReel?.()
    stopReel = undefined
  })
  window.addEventListener("pagehide", () => {
    stopReel?.()
    stopReel = undefined
  })
</script>
