---
import type { Lang } from "@/i18n/ui"
import { localizePath, useTranslations } from "@/i18n/utils"
import { buttonVariants } from "@/components/ui/button"
import LottiePlayer from "@/components/custom/lottie-player.astro"
import { cn } from "@/lib/utils"
import { ArrowRight } from "lucide-react"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const href = (es: string) => localizePath(lang, es)

const plaqueLabels = {
  subtitle: `${t("home.h1.1")} ${t("home.h1.2")}`,
  laser: t("home.plaque.laser"),
  laserValue: t("home.plaque.laserValue"),
  cut: t("home.plaque.cut"),
  since: t("home.plaque.since"),
}

const statusLabels = {
  ready: t("bench.status.ready"),
  burn: t("bench.status.burn"),
  done: t("bench.status.done"),
}
---

<section
  id="materiales"
  data-plaque-hero
  data-labels={JSON.stringify(plaqueLabels)}
  data-status-labels={JSON.stringify(statusLabels)}
  aria-labelledby="hero-title"
  class="plaque-hero-runway relative w-full scroll-mt-16 bg-background"
>
  <div
    data-plaque-stage
    class="plaque-hero-stage relative flex min-h-[calc(100svh-4rem)] w-full flex-col overflow-hidden bg-background px-5 py-6 md:px-10 lg:h-[calc(100svh-4rem)] lg:px-16 lg:py-8"
  >
    <!-- Subtle CNC millimetre bed that fades in during Act 2 -->
    <div
      data-cinema-bed
      aria-hidden="true"
      class="bed pointer-events-none absolute inset-0 opacity-25 transition-opacity duration-500"
    >
      <span data-gantry-x class="gantry gantry-x"></span>
      <span data-gantry-y class="gantry gantry-y"></span>
    </div>

    <!-- Ambient warm radial glow behind the plaque -->
    <div
      data-cinema-aura
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_52%,oklch(0.68_0.2_38/0.14)_0%,transparent_48%)]"
    ></div>

    <!-- Monumental kinetic wordmark BEHIND the 3D plaque (splits apart on scroll) -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-[5] flex select-none flex-col items-center justify-center overflow-hidden"
    >
      <span
        data-bg-word-left
        class="display whitespace-nowrap text-[clamp(5.5rem,20vw,19rem)] leading-[0.82] tracking-[-0.05em] text-white/[0.045] will-change-transform"
      >
        LASER
      </span>
      <span
        data-bg-word-right
        class="display whitespace-nowrap text-[clamp(5.5rem,20vw,19rem)] leading-[0.82] tracking-[-0.05em] text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,0.08)] will-change-transform"
      >
        COM
      </span>
    </div>

    <!-- Full-stage 3D WebGL canvas: the star of all 3 beats -->
    <canvas
      data-plaque-canvas
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-10 size-full opacity-0 transition-opacity duration-700"
    ></canvas>

    <!-- Subtle obsidian vignette framing the cinema viewport -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-10 bg-[radial-gradient(ellipse_at_50%_50%,transparent_38%,rgba(11,12,14,0.72)_100%)]"
    ></div>

    <!-- Minimal top bar: single progress hairline + quiet coordinates -->
    <div class="relative z-20 flex items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <LottiePlayer
          src="/lottie/laser-reticle.json"
          speed={0.85}
          class="size-6 shrink-0"
        />
        <span class="readout text-muted-foreground">{t("home.readout")}</span>
      </div>
    </div>

    <div
      data-hero-rule
      aria-hidden="true"
      class="relative z-20 mt-3 h-px bg-white/10"
    >
      <span
        data-engrave-progress
        class="absolute inset-0 origin-left scale-x-0 bg-[oklch(0.85_0.12_55)] shadow-[0_0_12px_1px_var(--laser)]"
      ></span>
    </div>

    <!-- =======================================================================
         BEAT 1: OPENING SHOT (spacious, monumental H1 + floating 3D plaque)
         Glides up and fades out smoothly as you begin scrolling.
         ======================================================================= -->
    <div
      data-beat-1
      class="pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-between px-5 pt-20 pb-[calc(5.5rem+env(safe-area-inset-bottom))] text-center md:px-10 md:pt-24 md:pb-12"
    >
      <div class="mx-auto flex max-w-4xl flex-col items-center">
        <h1
          id="hero-title"
          data-plaque-h1
          class="display max-w-[15ch] text-[clamp(2.1rem,6vw,5.4rem)] leading-[0.96] font-extrabold text-foreground drop-shadow-[0_16px_48px_rgba(0,0,0,0.75)]"
        >
          {t("home.h1.1")} {t("home.h1.2")} {t("home.h1.3")}
        </h1>
      </div>

      <div class="pointer-events-auto flex flex-col items-center gap-2 sm:gap-4">
        <a
          href={`${href("/contacto/")}#presupuesto`}
          data-magnetic
          class={cn(
            buttonVariants({ size: "cta" }),
            "shadow-[0_0_32px_rgba(243,242,238,0.16)]"
          )}
        >
          {t("nav.quote")}
          <ArrowRight className="size-4" aria-hidden />
        </a>
        <a
          href="#trabajos"
          class="inline-flex min-h-11 items-center gap-1.5 px-3 text-xs font-medium text-foreground/80 transition-colors hover:text-foreground lg:hidden"
        >
          {t("home.work.all")}
          <ArrowRight className="size-3.5 text-laser-ink" aria-hidden />
        </a>
      </div>
    </div>

    <!-- =======================================================================
         BEATS 2 & 3: THE ENGRAVING & FINALE (glides in on the left while
         the 3D plaque sweeps to the right and engraves 56 passes live)
         ======================================================================= -->
    <div
      data-beat-2
      class="pointer-events-none relative z-20 mx-auto my-auto grid w-full max-w-7xl flex-1 items-end pb-2 opacity-0 sm:pb-14 lg:grid-cols-12 lg:items-center lg:pb-0"
    >
      <div class="flex flex-col gap-6 lg:col-span-5">
        <h2
          data-beat-2-title
          class="display max-w-[10ch] text-[clamp(2rem,5.2vw,4.75rem)] leading-[0.96] text-foreground"
        >
          {t("home.engrave.title")}
        </h2>

        <!-- Material and live status of the engraving -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-y border-white/12 py-4 font-mono text-xs tracking-wider uppercase">
          <span class="text-foreground/85">{t("bench.m.acero.name")}</span>
          <span
            data-state="ready"
            class="inline-flex items-center gap-2 text-foreground/90"
          >
            <span
              aria-hidden="true"
              class="engrave-led size-1.5 rounded-full"
            ></span>
            <span data-status-text>{t("bench.status.ready")}</span>
          </span>
        </div>

        <!-- Beat 3 arrival: clean action pair once the engraving nears completion -->
        <div
          data-beat-3
          class="pointer-events-auto flex flex-col gap-3 opacity-0 sm:flex-row sm:items-center"
        >
          <a
            href={`${href("/contacto/")}#presupuesto`}
            data-magnetic
            class={cn(buttonVariants({ size: "cta" }))}
          >
            {t("nav.quote")}
            <ArrowRight className="size-4" aria-hidden />
          </a>
          <a
            href={href("/trabajos/")}
            class={cn(
              buttonVariants({ variant: "outline", size: "cta" }),
              "border-white/20 bg-background/85 text-foreground hover:bg-card dark:bg-background/85 dark:hover:bg-card"
            )}
          >
            {t("home.work.all")}
            <ArrowRight className="size-4 text-laser-ink" aria-hidden />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plaque-hero-stage {
    --mm: 1.5px;
  }

  .bed {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: calc(50 * var(--mm)) calc(50 * var(--mm));
  }

  .gantry {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    background: color-mix(in oklab, var(--laser) 55%, transparent);
    will-change: transform, opacity;
  }

  .gantry-x {
    width: 1px;
    height: 100%;
    box-shadow: 0 0 8px color-mix(in oklab, var(--laser) 35%, transparent);
  }

  .gantry-y {
    width: 100%;
    height: 1px;
    box-shadow: 0 0 8px color-mix(in oklab, var(--laser) 35%, transparent);
  }

  .engrave-led {
    background: rgb(255 255 255 / 0.4);
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }

  [data-state="burn"] .engrave-led {
    background: var(--laser);
    box-shadow: 0 0 8px 1px var(--laser);
  }

  [data-state="done"] .engrave-led {
    background: oklch(0.8 0.15 150);
    box-shadow: 0 0 8px 1px oklch(0.8 0.15 150 / 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-beat-1] {
      position: relative;
      inset: auto;
      padding-top: 2rem;
      padding-bottom: 1.5rem;
    }
    [data-beat-2],
    [data-beat-3] {
      opacity: 1 !important;
      pointer-events: auto;
    }
  }

  @media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    /* Long enough for the paced story below to play while the stage holds,
       short enough that the real work is a couple of swipes away */
    .plaque-hero-runway {
      min-height: 180svh;
    }

    .plaque-hero-stage {
      position: sticky;
      top: 4rem;
      height: calc(100svh - 4rem);
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  import type { PlaqueLabels, PlaqueStage3D } from "@/lib/monolith-3d"
  import {
    afterLoad,
    hasHardwareGL,
    loadScrollKit,
    type ScrollKit,
  } from "@/lib/after-load"

  let stopHero: (() => void) | undefined
  let visit = 0

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v))
  const smoothstep = (v: number) => v * v * (3 - 2 * v)
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t
  const seg = (p: number, a: number, b: number) =>
    smoothstep(clamp01((p - a) / Math.max(0.0001, b - a)))

  const bootPlaqueHero = ({ gsap, ScrollTrigger, SplitText }: ScrollKit) => {
    stopHero?.()
    stopHero = undefined

    const root = document.querySelector<HTMLElement>("[data-plaque-hero]")
    const stageEl = root?.querySelector<HTMLElement>("[data-plaque-stage]")
    const canvas = root?.querySelector<HTMLCanvasElement>(
      "[data-plaque-canvas]"
    )
    if (!root || !stageEl || !canvas) return

    const h1El = root.querySelector<HTMLElement>("[data-plaque-h1]")
    const beat1 = root.querySelector<HTMLElement>("[data-beat-1]")
    const beat2 = root.querySelector<HTMLElement>("[data-beat-2]")
    const beat3 = root.querySelector<HTMLElement>("[data-beat-3]")
    const bedEl = root.querySelector<HTMLElement>("[data-cinema-bed]")
    const bgWordLeft = root.querySelector<HTMLElement>("[data-bg-word-left]")
    const bgWordRight = root.querySelector<HTMLElement>("[data-bg-word-right]")
    const stateRow = root.querySelector<HTMLElement>("[data-state]")
    const statusTextEl = root.querySelector<HTMLElement>("[data-status-text]")
    const progressEl = root.querySelector<HTMLElement>(
      "[data-engrave-progress]"
    )
    const ruleEl = root.querySelector<HTMLElement>("[data-hero-rule]")
    const beat2Title = root.querySelector<HTMLElement>("[data-beat-2-title]")
    const gantryX = root.querySelector<HTMLElement>("[data-gantry-x]")
    const gantryY = root.querySelector<HTMLElement>("[data-gantry-y]")

    const labels: PlaqueLabels = JSON.parse(root.dataset.labels || "{}")
    const statusLabels: { ready: string; burn: string; done: string } =
      JSON.parse(root.dataset.statusLabels || "{}")

    let cancelled = false
    let plaque: PlaqueStage3D | null = null
    let currentProgress = 0
    let gantryTicker: (() => void) | null = null

    // 3-Act Awwwards cinema choreography driven by scroll progress p (0 -> 1)
    const computePose = (p: number) => {
      const w = stageEl.clientWidth || window.innerWidth
      const h = stageEl.clientHeight || window.innerHeight
      const isDesktop = w >= 1024

      // Beat 1 -> Beat 2 (0.04 -> 0.24): plaque glides from center hero to right CNC bed
      const moveToBed = seg(p, 0.04, 0.24)
      // Beat 2 engraving (0.22 -> 0.72): 56 passes rastered live with 3D sparks
      const engraveT = clamp01((p - 0.22) / 0.5)
      // Beat 3 finale (0.72 -> 1.0): a slow tilt that rakes the studio light
      // across the fresh engraving, then settles facing the visitor
      const tiltT = seg(p, 0.72, 0.98)
      const glint = Math.sin(tiltT * Math.PI)
      const finale = seg(p, 0.76, 1.0)

      const cx = isDesktop
        ? lerp(w * 0.5, w * 0.72, moveToBed) - finale * w * 0.025
        : w * 0.5

      // Phones stack the beat 2 copy under the plaque, so the plaque has to fit
      // the real gap between the top rule and that title (offsets ignore the
      // fade-in transforms)
      const gapTop = (ruleEl ? ruleEl.offsetTop + 1 : h * 0.12) + 12
      const gapBottom =
        (beat2 && beat2Title
          ? beat2.offsetTop + beat2Title.offsetTop
          : h * 0.62) - 16
      const gap = Math.max(gapBottom - gapTop, h * 0.2)

      const cy = isDesktop
        ? lerp(h * 0.575, h * 0.52, moveToBed)
        : lerp(h * 0.52, gapTop + gap / 2, moveToBed)

      // Beat 1 keeps the plaque below the headline so the two never collide
      const baseH = isDesktop
        ? Math.min(h * 0.42, 380)
        : Math.min(h * 0.38, 280)
      const bedH = isDesktop ? Math.min(h * 0.76, 590) : Math.min(gap, 320)
      const height = lerp(baseH, bedH, moveToBed) * (1 + finale * 0.07)

      // Camera Z dolly: wide hero -> macro engraving close-up -> grand showcase framing
      const camZ = lerp(8.1, 6.9, moveToBed) + finale * 0.35

      // 3/4 profile -> flat toward the laser -> light-raking tilt
      const rotY =
        lerp(-0.45, -0.06, moveToBed) +
        engraveT * 0.16 +
        glint * 0.5 -
        tiltT * 0.18
      const rotX = lerp(0.1, 0.04, moveToBed) - glint * 0.1
      const rotZ = lerp(-0.07, -0.015, moveToBed) + engraveT * 0.025

      return {
        cx,
        cy,
        height,
        rotY,
        rotX,
        rotZ,
        camZ,
        glint,
        engrave: engraveT,
      }
    }

    const applyCinemaFrame = (p: number, reduced = false) => {
      currentProgress = reduced ? 1 : p

      if (reduced) {
        if (stateRow) stateRow.dataset.state = "done"
        if (statusTextEl) statusTextEl.textContent = statusLabels.done ?? ""
        if (progressEl) progressEl.style.transform = "scaleX(1)"
        plaque?.setPose({
          ...computePose(1),
          engrave: 1,
        })
        return
      }

      // Direct DOM transform/opacity updates (zero per-frame tween allocation)
      const beat1Out = seg(p, 0.02, 0.22)
      if (beat1) {
        beat1.style.opacity = String(1 - beat1Out)
        beat1.style.transform = `translate3d(0, ${(-beat1Out * 72).toFixed(1)}px, 0) scale(${(1 - beat1Out * 0.04).toFixed(4)})`
        beat1.style.pointerEvents = beat1Out > 0.6 ? "none" : ""
      }

      const beat2In = seg(p, 0.2, 0.36)
      if (beat2) {
        beat2.style.opacity = String(beat2In)
        beat2.style.transform = `translate3d(0, ${((1 - beat2In) * 44).toFixed(1)}px, 0)`
      }

      const beat3In = seg(p, 0.74, 0.9)
      if (beat3) {
        beat3.style.opacity = String(beat3In)
        beat3.style.transform = `translate3d(0, ${((1 - beat3In) * 24).toFixed(1)}px, 0)`
        beat3.style.pointerEvents = beat3In > 0.35 ? "auto" : "none"
      }

      if (bedEl) {
        bedEl.style.opacity = String(0.2 + beat2In * 0.8)
      }

      // Opposing monumental background wordmark split
      const splitX = p * 26
      if (bgWordLeft) {
        bgWordLeft.style.transform = `translate3d(${(-splitX).toFixed(2)}%, 0, 0)`
      }
      if (bgWordRight) {
        bgWordRight.style.transform = `translate3d(${splitX.toFixed(2)}%, 0, 0)`
      }

      const engraveT = clamp01((p - 0.22) / 0.5)
      if (progressEl) {
        progressEl.style.transform = `scaleX(${p.toFixed(4)})`
      }

      const mode: "ready" | "burn" | "done" =
        engraveT >= 0.995 ? "done" : engraveT > 0.005 ? "burn" : "ready"
      if (stateRow) stateRow.dataset.state = mode
      if (statusTextEl) statusTextEl.textContent = statusLabels[mode] ?? ""

      plaque?.setPose(computePose(p))
    }

    const updateGantry = () => {
      const spot = plaque?.beam()
      if (!spot) {
        if (gantryX) gantryX.style.opacity = "0"
        if (gantryY) gantryY.style.opacity = "0"
        return
      }
      if (gantryX) {
        gantryX.style.opacity = "1"
        gantryX.style.transform = `translate3d(${spot.x.toFixed(1)}px, 0, 0)`
      }
      if (gantryY) {
        gantryY.style.opacity = "1"
        gantryY.style.transform = `translate3d(0, ${spot.y.toFixed(1)}px, 0)`
      }
    }

    const finePointer = window.matchMedia("(pointer: fine)").matches
    const onPointerMove = (e: PointerEvent) => {
      const nx = (e.clientX / Math.max(window.innerWidth, 1) - 0.5) * 2
      const ny = (e.clientY / Math.max(window.innerHeight, 1) - 0.5) * 2
      plaque?.setPointer(nx, ny)
    }
    if (finePointer) {
      window.addEventListener("pointermove", onPointerMove, { passive: true })
    }

    const resizeObserver = new ResizeObserver(() => {
      plaque?.resize()
      plaque?.setPose(computePose(currentProgress))
    })
    resizeObserver.observe(stageEl)

    const mm = gsap.matchMedia()
    // matchMedia only runs the callback while at least one query matches, so
    // phones need a query of their own or the hero never animates on them
    mm.add(
      {
        reduceMotion: "(prefers-reduced-motion: reduce)",
        isDesktop: "(min-width: 1024px)",
        isMobile: "(max-width: 1023px)",
      },
      (context) => {
        const { reduceMotion, isDesktop } = context.conditions ?? {}

        if (reduceMotion) {
          applyCinemaFrame(1, true)
          return
        }

        // Opening H1 staggered character reveal, desktop only: on phones the
        // headline is the largest paint, and hiding it for the reveal pushed
        // LCP past the 3s budget
        if (h1El && isDesktop) {
          SplitText.create(h1El, {
            type: "words, chars",
            mask: "words",
            aria: "auto",
            autoSplit: true,
            onSplit(self) {
              return gsap.from(self.chars, {
                yPercent: 108,
                autoAlpha: 0,
                duration: 0.78,
                stagger: 0.02,
                ease: "power3.out",
              })
            },
          })
        }

        applyCinemaFrame(0)

        // Phones: a flick covers the whole runway in a blink, so the story
        // chases the scroll at a capped pace instead of jumping with it. Each
        // beat keeps its time however hard the visitor swipes (about three
        // seconds end to end), and scrolling back stays brisk
        let target = 0
        let shown = 0
        const FORWARD_RATE = 0.52
        const BACK_RATE = 1.1
        const pace = (_time: number, deltaMs: number) => {
          const diff = target - shown
          if (Math.abs(diff) < 0.0004) {
            if (shown !== target) {
              shown = target
              applyCinemaFrame(shown)
            }
            return
          }
          const dt = Math.min(deltaMs, 100) / 1000
          const cap = (diff > 0 ? FORWARD_RATE : BACK_RATE) * dt
          const eased = diff * (1 - Math.exp(-7 * dt))
          shown += Math.sign(diff) * Math.min(Math.abs(eased), cap)
          applyCinemaFrame(shown)
        }

        // Top-level ScrollTrigger driving the entire 3-Act movie sequence
        ScrollTrigger.create({
          trigger: root,
          start: "top 64px",
          end: isDesktop ? "+=220%" : "bottom bottom",
          pin: Boolean(isDesktop),
          pinSpacing: Boolean(isDesktop),
          scrub: isDesktop ? 0.35 : true,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (isDesktop) applyCinemaFrame(self.progress)
            else target = self.progress
          },
        })

        if (!isDesktop) gsap.ticker.add(pace)
        gantryTicker = updateGantry
        gsap.ticker.add(updateGantry)

        return () => {
          gsap.ticker.remove(pace)
          if (gantryTicker) {
            gsap.ticker.remove(gantryTicker)
            gantryTicker = null
          }
        }
      }
    )

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches
    const boot3D = () => {
      if (cancelled || !hasHardwareGL()) return
      import("@/lib/monolith-3d").then(async ({ createPlaqueStage3D }) => {
        if (cancelled) return
        const light = window.innerWidth < 768
        const instance = await createPlaqueStage3D(canvas, labels, {
          light,
          reducedMotion,
        })
        if (cancelled) {
          instance?.destroy()
          return
        }
        plaque = instance
        if (plaque) {
          plaque.setPose(computePose(reducedMotion ? 1 : currentProgress))
          canvas.style.opacity = "1"
        }
      })
    }

    afterLoad(boot3D)

    return () => {
      cancelled = true
      mm.revert()
      resizeObserver.disconnect()
      if (finePointer) {
        window.removeEventListener("pointermove", onPointerMove)
      }
      plaque?.destroy()
      plaque = null
    }
  }

  document.addEventListener("astro:page-load", () => {
    const current = ++visit
    void loadScrollKit().then((kit) => {
      // The visitor may have moved on while GSAP loaded
      if (current === visit) stopHero = bootPlaqueHero(kit)
    })
  })
  document.addEventListener("astro:before-swap", () => {
    visit++
    stopHero?.()
    stopHero = undefined
  })
  window.addEventListener("pagehide", () => {
    stopHero?.()
    stopHero = undefined
  })
</script>
