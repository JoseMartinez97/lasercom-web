---
import type { ImageMetadata } from "astro"
import { getImage } from "astro:assets"
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import { films, type FilmName } from "@/lib/services"
import { cn } from "@/lib/utils"

interface Props {
  lang: Lang
  names: FilmName[]
}
const { lang, names } = Astro.props
const t = useTranslations(lang)
const base = import.meta.env.BASE_URL.replace(/\/$/, "")

const posters = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/film/*.jpg",
  { eager: true }
)
const items = await Promise.all(
  names.map(async (name) => {
    const source = Object.entries(posters).find(([path]) =>
      path.endsWith(`/${name}.jpg`)
    )
    if (!source) throw new Error(`No poster for film ${name}`)
    const { shape, folder } = films[name]
    const poster = await getImage({
      src: source[1].default,
      width: shape === "portrait" ? 720 : 1280,
      format: "webp",
      quality: 72,
    })
    return { name, shape, src: `${base}/video/${folder}/${name}`, poster }
  })
)
---

<!-- Follows the steel "why" list on service pages, so it continues that
     dark block instead of opening a new one -->
<section class="steel px-5 pt-4 pb-24 md:px-8 lg:pb-32">
  <div class="mb-12 flex flex-col gap-4">
    <h2 class="display text-[clamp(2.1rem,6vw,5.5rem)]" data-title-chars>
      {t("svc.common.films")}
    </h2>
    <p class="max-w-2xl text-muted-foreground md:text-lg">
      {t("svc.common.films.lead")}
    </p>
  </div>
  <div class="grid items-start gap-6 md:grid-cols-12 lg:gap-8">
    {items.map(({ name, shape, src, poster }) => (
      <figure
        data-wipe
        class={cn(
          "flex flex-col gap-3",
          shape === "portrait"
            ? "md:col-span-5 lg:col-span-4"
            : "md:col-span-7 lg:col-span-8"
        )}
      >
        <div
          class={cn(
            "relative overflow-hidden rounded-[1.75rem] border border-border/40 bg-black",
            shape === "portrait" ? "aspect-[4/5]" : "aspect-video"
          )}
        >
          <video
            data-machine-film
            muted
            loop
            playsinline
            preload="none"
            poster={poster.src}
            width={poster.attributes.width}
            height={poster.attributes.height}
            class="absolute inset-0 size-full object-cover"
          >
            <source src={`${src}.webm`} type="video/webm" />
            <source src={`${src}.mp4`} type="video/mp4" />
          </video>
        </div>
        <figcaption class="readout flex items-center gap-3 text-muted-foreground">
          <span class="inline-block size-2 shrink-0 rounded-full bg-laser"></span>
          {t(`film.${name}`)}
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  // Play each clip only while it is on screen. With reduced motion the
  // poster stays and the visitor can start the clip with the controls
  const setupFilms = () => {
    const clips = document.querySelectorAll<HTMLVideoElement>(
      "[data-machine-film]"
    )
    if (!clips.length) return () => {}

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      clips.forEach((clip) => {
        clip.controls = true
        clip.loop = false
      })
      return () => {}
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const clip = target as HTMLVideoElement
          if (isIntersecting) clip.play().catch(() => {})
          else clip.pause()
        }
      },
      { threshold: 0.35 }
    )
    clips.forEach((clip) => io.observe(clip))
    return () => {
      io.disconnect()
      clips.forEach((clip) => clip.pause())
    }
  }

  let cleanupFilms: (() => void) | undefined
  document.addEventListener("astro:page-load", () => {
    cleanupFilms?.()
    cleanupFilms = setupFilms()
  })
  document.addEventListener("astro:before-swap", () => {
    cleanupFilms?.()
    cleanupFilms = undefined
  })
</script>
