---
import { toggleVariants } from "@/components/ui/toggle"
import { languages, type Lang } from "@/i18n/ui"
import { getAlternatePath, localizePath } from "@/i18n/utils"
import { cn } from "@/lib/utils"

interface Props {
  currentLang: Lang
  path: string
}

const { currentLang, path } = Astro.props
---

<div class="flex w-fit rounded-2xl">
  {(Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
    <a
      href={getAlternatePath(path, code) ?? localizePath(code, "/")}
      hreflang={code}
      lang={code}
      aria-label={`${code.toUpperCase()} – ${label}`}
      aria-current={code === currentLang ? "page" : undefined}
      class={cn(
        toggleVariants({ variant: "outline", size: "sm" }),
        "relative min-h-11 min-w-11 rounded-none px-3 font-mono text-xs no-underline not-first:border-l-0 first:rounded-l-2xl last:rounded-r-2xl focus-visible:z-10 aria-[current=page]:bg-muted sm:min-h-9 sm:min-w-9 sm:px-2.5"
      )}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>
