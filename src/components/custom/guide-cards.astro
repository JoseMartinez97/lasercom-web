---
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { guides, guideIds, type GuideId } from "@/lib/guides"
import { ArrowRight } from "lucide-react"

interface Props {
  lang: Lang
  ids?: readonly GuideId[]
  headingLevel?: "h2" | "h3"
}
const { lang, ids = guideIds, headingLevel: Heading = "h3" } = Astro.props
const t = useTranslations(lang)
---

<ul class="grid gap-5 md:grid-cols-3" data-stagger>
  {ids.map((id) => (
    <li>
      <a
        href={lang === "en" ? guides[id].en : guides[id].es}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-foreground/25"
      >
        <span class="relative block aspect-[16/10] overflow-hidden border-b border-border/60 bg-secondary">
          <WorkPhoto
            lang={lang}
            name={guides[id].photo}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="absolute inset-0 size-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
        </span>
        <span class="flex flex-1 flex-col gap-3 p-6">
          <span class="readout text-muted-foreground">
            {t("guides.label")} · {t(`guide.${id}.minutes`)}{" "}
            {t("guides.minutes")}
          </span>
          <Heading class="text-lg leading-snug font-semibold tracking-tight text-foreground transition-colors group-hover:text-laser-ink md:text-xl">
            {t(`guide.${id}.h1`)}
          </Heading>
          <span class="text-sm leading-relaxed text-muted-foreground">
            {t(`guide.${id}.lead`)}
          </span>
          <span class="mt-auto inline-flex items-center gap-2 pt-3 text-sm font-medium text-foreground">
            {t("guides.read")}
            <ArrowRight
              className="size-4 text-laser-ink transition-transform group-hover:translate-x-1"
              aria-hidden
            />
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
