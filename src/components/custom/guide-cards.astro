---
import type { Lang } from "@/i18n/ui"
import { useTranslations } from "@/i18n/utils"
import WorkPhoto from "@/components/custom/work-photo.astro"
import { guides, guideIds, type GuideId } from "@/lib/guides"
import { ArrowRight } from "lucide-react"

// The guides as cards: photo, title, lead and reading time
interface Props {
  lang: Lang
  ids?: readonly GuideId[]
  headingLevel?: "h2" | "h3"
}
const { lang, ids = guideIds, headingLevel: Heading = "h3" } = Astro.props
const t = useTranslations(lang)
---

<ul class="grid gap-4 md:grid-cols-3" data-stagger>
  {ids.map((id) => (
    <li>
      <a
        href={lang === "en" ? guides[id].en : guides[id].es}
        data-cursor={t("guides.read")}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors hover:border-foreground hover:bg-foreground hover:text-background"
      >
        <span class="relative block aspect-[16/10] overflow-hidden border-b border-border/60 bg-[#f9f4eb]">
          <WorkPhoto
            lang={lang}
            name={guides[id].photo}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="absolute inset-0 size-full transition-transform duration-700 ease-out group-hover:scale-105"
          />
        </span>
        <span class="flex flex-1 flex-col gap-3 p-6">
          <span class="readout text-laser-ink group-hover:text-laser">
            {t("guides.label")} · {t(`guide.${id}.minutes`)}{" "}
            {t("guides.minutes")}
          </span>
          <Heading class="text-2xl leading-tight font-bold tracking-tight">
            {t(`guide.${id}.h1`)}
          </Heading>
          <span class="opacity-75">{t(`guide.${id}.lead`)}</span>
          <span class="mt-auto inline-flex items-center gap-2 pt-4 font-semibold">
            {t("guides.read")}
            <ArrowRight className="size-4 text-laser-ink transition-transform group-hover:text-laser group-hover:translate-x-1" />
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
