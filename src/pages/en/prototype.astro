---
import Layout from "@/layouts/main.astro"
import LaserLab from "@/components/custom/laser-lab.astro"
import { useTranslations } from "@/i18n/utils"

// Design prototype, for the owner to compare with the current home page.
// Kept out of search engines and the sitemap
const t = useTranslations("en")
---

<Layout
  lang="en"
  title={t("lab.title")}
  description={t("lab.description")}
  noindex
>
  <LaserLab lang="en" />
</Layout>
